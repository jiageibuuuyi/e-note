<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
             x:Class="DesktopNotes.Desktop.Controls.TaskRow"
             x:DataType="vm:TaskRowViewModel">
  <Border Name="RowContainer"
          Classes="task-card"
          MinHeight="44"
          Margin="{Binding RowMargin}"
          Cursor="Hand"
          DragDrop.AllowDrop="True">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Name="MenuAddSubtask"
                  Header="{Binding Loc.RowMenuAddSubtask}"
                  IsVisible="{Binding CanAddSubtask}"/>
        <MenuItem Name="MenuPromoteSubtask"
                  Header="{Binding Loc.RowMenuPromoteSubtask}"
                  IsVisible="{Binding IsSubtask}"/>
        <MenuItem Name="MenuOpenDetail"
                  Header="{Binding Loc.RowMenuOpenDetail}"/>
        <MenuItem Name="MenuCompleteRow"
                  Header="{Binding CompleteMenuHeader}"/>
        <MenuItem Name="MenuArchiveRow"
                  Header="{Binding Loc.RowMenuArchive}"/>
        <Separator/>
        <MenuItem Name="MenuTrashRow"
                  Header="{Binding Loc.RowMenuTrash}"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid ColumnDefinitions="Auto,*">
      <!-- Left Vertical Accent Pill for Overdue / Today / Completed -->
      <Panel Grid.Column="0" VerticalAlignment="Stretch" Margin="0,2,10,2">
        <Border Width="3.5" CornerRadius="2"
                Background="{DynamicResource StatusOverdue}"
                IsVisible="{Binding IsOverdue}"/>
        <Border Width="3.5" CornerRadius="2"
                Background="{DynamicResource StatusDueToday}"
                IsVisible="{Binding IsDueToday}"/>
        <Border Width="3.5" CornerRadius="2"
                Background="{DynamicResource StatusCompleted}"
                IsVisible="{Binding IsMarkedCompleted}"/>
      </Panel>

      <!-- Main Content Area -->
      <StackPanel Grid.Column="1" Spacing="8">
        <!-- Row Header: DragHandle + TreeToggle/Branch + Checkbox + Title/InlineInput + SubtaskCount + Priority + Status/Archive Pill -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
          <!-- Drag Handle for Task-to-Subtask Drag & Drop -->
          <Border Name="DragHandleBorder"
                  Grid.Column="0"
                  IsVisible="{Binding IsTaskRow}"
                  Background="Transparent"
                  Padding="2,2,4,2"
                  Margin="-2,0,2,0"
                  Cursor="SizeAll"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Loc.RowDragHandleTooltip}">
            <TextBlock Text="⠿"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
          </Border>

          <!-- Parent Task Tree Expand/Collapse Toggle (▼ / ▶) & Subtask Tree Branch Connector (├─ / └─) -->
          <Panel Grid.Column="1" VerticalAlignment="Center">
            <Button Name="TreeToggleButton"
                    IsVisible="{Binding HasSubtasks}"
                    Classes="icon-ghost"
                    Width="20" Height="20"
                    Padding="0"
                    Margin="0,0,4,0"
                    FontSize="11.5"
                    Content="{Binding TreeToggleGlyph}"
                    ToolTip.Tip="{Binding TreeToggleTooltip}"/>
            <TextBlock Text="{Binding TreeBranchPrefix}"
                       IsVisible="{Binding IsSubtask}"
                       Foreground="{DynamicResource AccentPrimary}"
                       FontFamily="Consolas, Microsoft YaHei UI, monospace"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
          </Panel>

          <CheckBox Name="CompleteCheckBox"
                    Grid.Column="2"
                    Classes="task-check"
                    IsChecked="{Binding IsMarkedCompleted, Mode=OneWay}"
                    IsEnabled="{Binding IsDisplayMode}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTip.Tip="{Binding Loc.RowCheckTooltip}"/>

          <!-- Display & Editable Title (Normal Uncompleted Mode: Supports Mouse Text Selection Copy & Direct Edit) -->
          <TextBox Name="TitleDisplayBox"
                   Grid.Column="3"
                   IsVisible="{Binding IsDisplayNormal}"
                   Classes="clean-input"
                   Text="{Binding EditableTitle}"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="13.5"
                   FontWeight="Normal"
                   VerticalAlignment="Center"/>

          <!-- Display Title (Completed Mode: Strikethrough + Muted + Selectable for Copy) -->
          <SelectableTextBlock Grid.Column="3"
                               IsVisible="{Binding IsDisplayCompleted}"
                               Text="{Binding EditableTitle}"
                               TextDecorations="Strikethrough"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="13.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

          <!-- Inline Editable Input (When Adding New Blank Row at Bottom or Subtask) -->
          <TextBox Name="InlineTitleBox"
                   Grid.Column="3"
                   IsVisible="{Binding IsEditingInline}"
                   Classes="clean-input"
                   Text="{Binding InlineEditText}"
                   PlaceholderText="{Binding InlinePlaceholder}"
                   FontSize="13.5"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center"/>

          <!-- Subtask Count Badge on Parent Task -->
          <Border Grid.Column="4"
                  IsVisible="{Binding HasSubtasks}"
                  Background="{DynamicResource BgSubtle}"
                  CornerRadius="5"
                  Padding="5,1.5"
                  Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="包含的子任务数量">
            <TextBlock Text="{Binding SubtaskCountText}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="10.5"/>
          </Border>

          <!-- Priority Indicator Pill -->
          <Border Grid.Column="5"
                  IsVisible="{Binding HasPriorityBadge}"
                  Background="{DynamicResource P0_Bg}"
                  CornerRadius="5"
                  Padding="6,2"
                  Margin="6,0,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding PriorityBadge}"
                       Foreground="{DynamicResource P0_Highest}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>

          <!-- Deadline / Completed Status Pill (今日 / 逾期 / ✓ 已完成) -->
          <Panel Grid.Column="6"
                 IsVisible="{Binding HasStageLabel}"
                 Margin="6,0,0,0"
                 VerticalAlignment="Center">
            <Border IsVisible="{Binding IsOverdue}"
                    Background="{DynamicResource StatusOverdueBg}"
                    CornerRadius="5"
                    Padding="7,2.5">
              <TextBlock Text="{Binding StageLabel}"
                         Foreground="{DynamicResource StatusOverdue}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </Border>
            <Border IsVisible="{Binding IsDueToday}"
                    Background="{DynamicResource StatusDueTodayBg}"
                    CornerRadius="5"
                    Padding="7,2.5">
              <TextBlock Text="{Binding StageLabel}"
                         Foreground="{DynamicResource StatusDueToday}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </Border>
            <Border IsVisible="{Binding IsMarkedCompleted}"
                    Background="{DynamicResource StatusCompletedBg}"
                    CornerRadius="5"
                    Padding="7,2.5">
              <TextBlock Text="{Binding StageLabel}"
                         Foreground="{DynamicResource StatusCompleted}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </Border>
          </Panel>

          <!-- Confirm Archive Button (Shown directly on row when Marked Completed) -->
          <Button Name="ConfirmArchiveButton"
                  Grid.Column="7"
                  IsVisible="{Binding IsMarkedCompleted}"
                  Classes="ghost-link"
                  Padding="6,2"
                  Margin="4,0,0,0"
                  FontSize="11"
                  Content="{Binding Loc.RowArchiveBtn}"
                  ToolTip.Tip="{Binding Loc.RowArchiveTooltip}"/>

          <!-- Inline Edit Save / Cancel Buttons (Shown when IsEditingInline is true) -->
          <StackPanel Grid.Column="7"
                      IsVisible="{Binding IsEditingInline}"
                      Orientation="Horizontal"
                      Spacing="2"
                      Margin="4,0,0,0"
                      VerticalAlignment="Center">
            <Button Name="InlineSaveButton"
                    Classes="ghost-link"
                    Padding="6,2"
                    FontSize="11.5"
                    Content="{Binding Loc.RowSaveBtn}"
                    ToolTip.Tip="{Binding Loc.RowSaveTooltip}"/>
            <Button Name="InlineCancelButton"
                    Classes="icon-ghost"
                    Width="20" Height="20"
                    FontSize="10"
                    Content="✕"
                    ToolTip.Tip="{Binding Loc.RowCancelTooltip}"/>
          </StackPanel>
        </Grid>

        <!-- Expanded Drawer with Smooth Layout -->
        <Border Name="ExpandedDrawerBorder"
                 IsVisible="{Binding IsExpanded}"
                 BorderBrush="{DynamicResource BorderSubtle}"
                 BorderThickness="0,1,0,0"
                 Padding="26,10,2,2"
                 MaxHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <!-- Body Preview (Selectable for Copy) -->
              <SelectableTextBlock Text="{Binding Body}"
                                   IsVisible="{Binding HasBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12.5"
                                   LineHeight="20"
                                   TextWrapping="Wrap"/>

              <!-- Meta Footer Strip -->
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <!-- Due Date Pill (Only for Tasks; Notes only show Title, Details & Attachments) -->
                  <Border IsVisible="{Binding IsTaskKind}"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="6,2.5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="11" Height="11"
                                Foreground="{DynamicResource TextMuted}"
                                Data="M 19 4 L 18 4 L 18 2 L 16 2 L 16 4 L 8 4 L 8 2 L 6 2 L 6 4 L 5 4 A 2 2 0 0 0 3 6 L 3 20 A 2 2 0 0 0 5 22 L 19 22 A 2 2 0 0 0 21 20 L 21 6 A 2 2 0 0 0 19 4 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 19 8 L 5 8 L 5 6 L 19 6 L 19 8 Z"/>
                      <TextBlock Text="{Binding DueSummary}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11.5"/>
                    </StackPanel>
                  </Border>

                  <!-- Assignee Pill -->
                  <Border IsVisible="{Binding HasAssignee}"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="6,2.5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="11" Height="11"
                                Foreground="{DynamicResource TextMuted}"
                                Data="M 12 12 A 4 4 0 1 0 12 4 A 4 4 0 1 0 12 12 Z M 12 14 C 9.33 14 4 15.34 4 18 L 4 20 L 20 20 L 20 18 C 20 15.34 14.67 14 12 14 Z"/>
                      <TextBlock Text="{Binding Assignee}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11.5"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Add Subtask & Open Detail Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Name="AddSubtaskButton"
                          IsVisible="{Binding CanAddSubtask}"
                          Classes="ghost-link"
                          Content="{Binding Loc.RowAddSubtaskBtn}"
                          ToolTip.Tip="{Binding Loc.RowAddSubtaskTooltip}"/>
                  <Button Name="OpenDetailButton"
                          Classes="ghost-link"
                          Content="{Binding Loc.RowOpenDetailBtn}"
                          ToolTip.Tip="{Binding Loc.RowOpenDetailTooltip}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
