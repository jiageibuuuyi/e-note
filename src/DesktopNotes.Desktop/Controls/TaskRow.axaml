<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
             x:Class="DesktopNotes.Desktop.Controls.TaskRow"
             x:DataType="vm:TaskRowViewModel">
  <Border Name="RowContainer"
          Classes="task-card"
          MinHeight="40"
          Cursor="Hand"
          DragDrop.AllowDrop="True">
    <Grid ColumnDefinitions="Auto,*">
      <!-- Left Semantic Accent Pill Bar (Overdue or DueToday) -->
      <Panel Grid.Column="0" VerticalAlignment="Stretch" Margin="0,1,8,1">
        <Border Width="3.5" CornerRadius="2"
                Background="{DynamicResource StatusOverdue}"
                IsVisible="{Binding IsOverdue}"/>
        <Border Width="3.5" CornerRadius="2"
                Background="{DynamicResource StatusDueToday}"
                IsVisible="{Binding IsDueToday}"/>
      </Panel>

      <!-- Main Card Content -->
      <StackPanel Grid.Column="1" Spacing="7">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <CheckBox Name="CompleteCheckBox"
                    Grid.Column="0"
                    MinWidth="20"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    ToolTip.Tip="标记完成并归档"/>

          <!-- Subtask Indicator -->
          <TextBlock Grid.Column="1"
                     Text="↳ "
                     IsVisible="{Binding IsSubtask}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="13"
                     VerticalAlignment="Center"/>

          <!-- Task/Note Display Title -->
          <TextBlock Grid.Column="2"
                     Text="{Binding DisplayTitle}"
                     Foreground="{DynamicResource TextPrimary}"
                     FontSize="13.5"
                     FontWeight="Medium"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>

          <!-- Priority Pill (P0 / P1) -->
          <Border Grid.Column="3"
                  IsVisible="{Binding HasPriorityBadge}"
                  Background="{DynamicResource BgHover}"
                  CornerRadius="4"
                  Padding="5,1.5"
                  Margin="6,0,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding PriorityBadge}"
                       Foreground="{DynamicResource P0_Highest}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>

          <!-- Due Today / Overdue Semantic Pill -->
          <Panel Grid.Column="4"
                 IsVisible="{Binding HasStageLabel}"
                 Margin="6,0,0,0"
                 VerticalAlignment="Center">
            <Border IsVisible="{Binding IsOverdue}"
                    Background="{DynamicResource StatusOverdueBg}"
                    CornerRadius="5"
                    Padding="6,2">
              <TextBlock Text="{Binding StageLabel}"
                         Foreground="{DynamicResource StatusOverdue}"
                         FontSize="11.5"
                         FontWeight="SemiBold"/>
            </Border>
            <Border IsVisible="{Binding IsDueToday}"
                    Background="{DynamicResource StatusDueTodayBg}"
                    CornerRadius="5"
                    Padding="6,2">
              <TextBlock Text="{Binding StageLabel}"
                         Foreground="{DynamicResource StatusDueToday}"
                         FontSize="11.5"
                         FontWeight="SemiBold"/>
            </Border>
          </Panel>
        </Grid>

        <!-- Expanded Summary Drawer -->
        <Border IsVisible="{Binding IsExpanded}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,8,0,2"
                MaxHeight="200">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Body}"
                         IsVisible="{Binding HasBody}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="12.5"
                         LineHeight="19"
                         TextWrapping="Wrap"/>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DueSummary}"
                             Foreground="{DynamicResource TextMuted}"
                             FontSize="12"/>
                  <TextBlock Text="{Binding Assignee}"
                             IsVisible="{Binding HasAssignee}"
                             Foreground="{DynamicResource TextMuted}"
                             FontSize="12"/>
                </StackPanel>

                <Button Name="OpenDetailButton"
                        Grid.Column="1"
                        Classes="ghost-link"
                        Content="详情 ↗"
                        ToolTip.Tip="打开完整编辑窗口"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
