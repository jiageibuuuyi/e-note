<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\app-icon.ico</ApplicationIcon>
    <AssemblyTitle>e-note</AssemblyTitle>
    <Product>e-note</Product>
    <Authors>e-note Authors</Authors>
    <Company>e-note</Company>
    <Copyright>Copyright (C) 2026 e-note Authors. All rights reserved.</Copyright>
    <Description>Cross-platform aesthetic desktop sticky notes and todo management workspace.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopNotes.Infrastructure\DesktopNotes.Infrastructure.csproj" />
    <ProjectReference Include="..\DesktopNotes.Platforms\DesktopNotes.Platforms.csproj" />
  </ItemGroup>

  <Target Name="CheckSystemTimeZoneAndGenerateBuildConfig" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <_BuildEnvFile>$(OutputPath)build-env.json</_BuildEnvFile>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$tz = [System.TimeZoneInfo]::Local; $obj = @{ detectedTimeZoneId = $tz.Id; detectedTimeZoneDisplayName = $tz.DisplayName; detectedUtcOffset = $tz.BaseUtcOffset.ToString(); defaultLanguage = 'en' }; $obj | ConvertTo-Json | Set-Content -Path '$(_BuildEnvFile)' -Encoding UTF8; Write-Host ('[DesktopNotes Build Check] TimeZone=' + $tz.Id + ' (' + $tz.DisplayName + ') | DefaultLanguage=en')&quot;" />
  </Target>
  <Target Name="RemovePdbFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdbFiles Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbFiles)" />
  </Target>
</Project>
