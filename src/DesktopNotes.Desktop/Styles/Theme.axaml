<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
            <!-- Embedded Muyao Softbrush Handwriting Font & Standard Modern Font -->
      <FontFamily x:Key="MuyaoFont">avares://DesktopNotes.Desktop/Assets/Fonts#Muyao-Softbrush, Microsoft YaHei UI, Segoe UI Variable, sans-serif</FontFamily>
      <FontFamily x:Key="StandardFont">Segoe UI Variable, Plus Jakarta Sans, Microsoft YaHei UI, -apple-system, sans-serif</FontFamily>

      <!-- Realistic Sticky Note Warm Yellow Palette (#FFF5A8 -> #FEE974 -> #FDDD4E) -->
      <LinearGradientBrush x:Key="PaperWarmGradient" StartPoint="0%,0%" EndPoint="6%,100%">
        <GradientStop Offset="0.0" Color="#FFF5A8"/>
        <GradientStop Offset="0.42" Color="#FEE974"/>
        <GradientStop Offset="1.0" Color="#FDDD4E"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="PaperBorderBrush" Color="#C9A11E"/>
      <SolidColorBrush x:Key="PaperCreaseBrush" Color="#B58D12"/>
      <SolidColorBrush x:Key="InkBlackBrush" Color="#141414"/>
      <SolidColorBrush x:Key="InkMutedBrush" Color="#75141414"/>
      <BoxShadows x:Key="PaperStickyShadow">0 2 5 0 #1A966E0A, 0 10 20 -2 #298C640A, 0 18 28 -6 #22785005</BoxShadows>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Canvas & Surfaces -->
          <SolidColorBrush x:Key="BgWindow" Color="#F8FAFC"/>
          <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BgCardHover" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="BgSubtle" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="BgHover" Color="#E2E8F0"/>
          
          <!-- Typography -->
          <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
          <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
          
          <!-- Borders & Outlines -->
          <SolidColorBrush x:Key="BorderSubtle" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="BorderStrong" Color="#CBD5E1"/>
          <SolidColorBrush x:Key="BorderFocus" Color="#2563EB"/>
          
          <!-- Accents -->
          <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB"/>
          <SolidColorBrush x:Key="AccentPrimaryHover" Color="#1D4ED8"/>
          <SolidColorBrush x:Key="AccentSubtle" Color="#EFF6FF"/>
          
          <!-- Deadlines & Status -->
          <SolidColorBrush x:Key="StatusDueToday" Color="#D97706"/>
          <SolidColorBrush x:Key="StatusDueTodayBg" Color="#FEF3C7"/>
          <SolidColorBrush x:Key="StatusOverdue" Color="#DC2626"/>
          <SolidColorBrush x:Key="StatusOverdueBg" Color="#FEE2E2"/>
          <SolidColorBrush x:Key="StatusCompleted" Color="#16A34A"/>
          <SolidColorBrush x:Key="StatusCompletedBg" Color="#DCFCE7"/>
          
          <!-- Priorities -->
          <SolidColorBrush x:Key="P0_Highest" Color="#EF4444"/>
          <SolidColorBrush x:Key="P0_Bg" Color="#FEE2E2"/>
          <SolidColorBrush x:Key="P1_High" Color="#F97316"/>
          <SolidColorBrush x:Key="P1_Bg" Color="#FFEDD5"/>
          <SolidColorBrush x:Key="P2_Normal" Color="#3B82F6"/>
          <SolidColorBrush x:Key="P2_Bg" Color="#EFF6FF"/>
          <SolidColorBrush x:Key="P3_Low" Color="#64748B"/>
          <SolidColorBrush x:Key="P3_Bg" Color="#F1F5F9"/>

          <!-- Shadow colors (as Brush) -->
          <BoxShadows x:Key="CardShadow">0 1 3 0 #0D000000, 0 1 2 -1 #0D000000</BoxShadows>
          <BoxShadows x:Key="CardHoverShadow">0 4 6 -1 #15000000, 0 2 4 -2 #15000000</BoxShadows>
          <BoxShadows x:Key="WindowShadow">0 10 25 -5 #20000000, 0 8 10 -6 #15000000</BoxShadows>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <!-- Canvas & Surfaces -->
          <SolidColorBrush x:Key="BgWindow" Color="#121215"/>
          <SolidColorBrush x:Key="BgCard" Color="#1A1A1E"/>
          <SolidColorBrush x:Key="BgCardHover" Color="#242429"/>
          <SolidColorBrush x:Key="BgSubtle" Color="#202026"/>
          <SolidColorBrush x:Key="BgHover" Color="#2A2A32"/>
          
          <!-- Typography -->
          <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F6"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
          <SolidColorBrush x:Key="TextMuted" Color="#71717A"/>
          
          <!-- Borders & Outlines -->
          <SolidColorBrush x:Key="BorderSubtle" Color="#2A2A32"/>
          <SolidColorBrush x:Key="BorderStrong" Color="#3E3E48"/>
          <SolidColorBrush x:Key="BorderFocus" Color="#3B82F6"/>
          
          <!-- Accents -->
          <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6"/>
          <SolidColorBrush x:Key="AccentPrimaryHover" Color="#60A5FA"/>
          <SolidColorBrush x:Key="AccentSubtle" Color="#1E293B"/>
          
          <!-- Deadlines & Status -->
          <SolidColorBrush x:Key="StatusDueToday" Color="#F59E0B"/>
          <SolidColorBrush x:Key="StatusDueTodayBg" Color="#3E2305"/>
          <SolidColorBrush x:Key="StatusOverdue" Color="#F87171"/>
          <SolidColorBrush x:Key="StatusOverdueBg" Color="#3B1214"/>
          <SolidColorBrush x:Key="StatusCompleted" Color="#4ADE80"/>
          <SolidColorBrush x:Key="StatusCompletedBg" Color="#064E3B"/>
          
          <!-- Priorities -->
          <SolidColorBrush x:Key="P0_Highest" Color="#F87171"/>
          <SolidColorBrush x:Key="P0_Bg" Color="#3B1214"/>
          <SolidColorBrush x:Key="P1_High" Color="#FB923C"/>
          <SolidColorBrush x:Key="P1_Bg" Color="#3D200A"/>
          <SolidColorBrush x:Key="P2_Normal" Color="#60A5FA"/>
          <SolidColorBrush x:Key="P2_Bg" Color="#172554"/>
          <SolidColorBrush x:Key="P3_Low" Color="#94A3B8"/>
          <SolidColorBrush x:Key="P3_Bg" Color="#27272A"/>

          <!-- Shadow colors (as Brush) -->
          <BoxShadows x:Key="CardShadow">0 1 3 0 #30000000</BoxShadows>
          <BoxShadows x:Key="CardHoverShadow">0 4 8 0 #45000000</BoxShadows>
          <BoxShadows x:Key="WindowShadow">0 16 32 0 #70000000</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Global default font and text rendering -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Plus Jakarta Sans, Microsoft YaHei UI, -apple-system, sans-serif"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Clean ListBox without blue selection boxes -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Modern Rounded Checkbox Style -->
  <Style Selector="CheckBox.task-check">
    <Setter Property="MinWidth" Value="20"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="CheckBorder"
                Width="18" Height="18"
                CornerRadius="5"
                BorderThickness="1.5"
                BorderBrush="{DynamicResource BorderStrong}"
                Background="Transparent"
                Transitions="{x:Null}">
          <Path Name="CheckMark"
                Width="9" Height="7"
                Stretch="Uniform"
                Fill="#FFFFFF"
                IsVisible="False"
                Data="M3.8 6.6L1.4 4.2L0 5.6L3.8 9.4L12 1.2L10.6 0L3.8 6.6Z"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.task-check:pointerover /template/ Border#CheckBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
  </Style>
  <Style Selector="CheckBox.task-check:checked /template/ Border#CheckBorder">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
  </Style>
  <Style Selector="CheckBox.task-check:checked /template/ Path#CheckMark">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <!-- Segmented Control Button (kept for backward compatibility) -->
  <Style Selector="Button.seg-pill">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.seg-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.seg-pill.active">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Compact Header Mode Selector Pill -->
  <Style Selector="Button.mode-pill">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.mode-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
  </Style>

  <!-- Minimalist Icon Ghost Button (26x26) -->
  <Style Selector="Button.icon-ghost">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.icon-ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <!-- MenuFlyout Presenter and Menu Items for clean floating popups -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="Margin" Value="4,3"/>
    <Setter Property="Height" Value="1"/>
  </Style>

  <!-- Subtle Inline Ghost Action Link -->
  <Style Selector="Button.ghost-link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.ghost-link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryHover}"/>
  </Style>

  <!-- Primary Pill Action Button -->
  <Style Selector="Button.primary-pill">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.primary-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryHover}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- Secondary Pill Button -->
  <Style Selector="Button.secondary-pill">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.secondary-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
  </Style>

  <!-- Danger Action Button -->
  <Style Selector="Button.danger-btn">
    <Setter Property="Background" Value="#EA3323"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.danger-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C92517"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- Danger Ghost Link/Button -->
  <Style Selector="Button.danger-ghost-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#EA3323"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#4DEA3323"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.danger-ghost-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1AEA3323"/>
    <Setter Property="BorderBrush" Value="#EA3323"/>
    <Setter Property="Foreground" Value="#EA3323"/>
  </Style>

  <!-- Drawer Action Button (Refined compact pill button) -->
  <Style Selector="Button.drawer-action-btn">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.drawer-action-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
  </Style>

  <!-- Drawer Delete Button (Clear danger style, separated) -->
  <Style Selector="Button.drawer-delete-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusOverdue}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.drawer-delete-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatusOverdueBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StatusOverdue}"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusOverdue}"/>
  </Style>

  <!-- Compact Drawer Icon Button (Graphical toolbar) -->
  <Style Selector="Button.drawer-icon-btn">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.drawer-icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
  </Style>

  <!-- Compact Drawer Danger Icon Button (Trash icon) -->
  <Style Selector="Button.drawer-danger-icon-btn">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusOverdue}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.drawer-danger-icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatusOverdueBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StatusOverdue}"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusOverdue}"/>
  </Style>

  <!-- Drawer Chart Pill (Mini Progress Bar & Percentage Chart) -->
  <Style Selector="Border.drawer-chart-pill">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Drawer Meta Info Pill -->
  <Style Selector="Border.meta-pill">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
  </Style>

  <!-- Clean Borderless TextBox -->
  <Style Selector="TextBox.clean-input">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.clean-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.clean-input:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Task Row Card -->
  <Style Selector="Border.task-card">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,3.5"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
  </Style>
  <Style Selector="Border.task-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardHoverShadow}"/>
  </Style>

  <!-- ============================================================ -->
  <!-- REALISTIC STICKY NOTE STYLES (Strictly Scoped via .realistic)  -->
  <!-- ============================================================ -->
  <Style Selector="Window.realistic">
    <Setter Property="FontFamily" Value="{StaticResource MuyaoFont}"/>
  </Style>
  <Style Selector="Window.realistic TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MuyaoFont}"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="Window.realistic TextBox">
    <Setter Property="FontFamily" Value="{StaticResource MuyaoFont}"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="Window.realistic Button">
    <Setter Property="FontFamily" Value="{StaticResource MuyaoFont}"/>
  </Style>
  <Style Selector="Window.realistic SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MuyaoFont}"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>

  <!-- Realistic Paper Row -->
  <Style Selector="Border.paper-row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>
  <Style Selector="Border.paper-row:pointerover">
    <Setter Property="Background" Value="#12141414"/>
  </Style>

  <!-- Realistic Subtask Tree (Subtle left line border matching prototype) -->
  <Style Selector="Border.paper-row.subtask-tree">
    <Setter Property="BorderBrush" Value="#4D141414"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="CornerRadius" Value="0,8,8,0"/>
    <Setter Property="Padding" Value="8,2,4,2"/>
  </Style>

  <!-- Cute Hand-drawn Round Checkbox -->
  <Style Selector="CheckBox.cute-check">
    <Setter Property="MinWidth" Value="19"/>
    <Setter Property="MinHeight" Value="19"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="CuteCheckBorder"
                Width="19" Height="19"
                Background="#7AFFFFFF"
                BorderBrush="#141414"
                BorderThickness="1.8"
                CornerRadius="8">
          <TextBlock Name="CheckGlyph"
                     Text="✓"
                     Foreground="#FFFFFF"
                     FontSize="12"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="False"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.cute-check:checked /template/ Border#CuteCheckBorder">
    <Setter Property="Background" Value="#EA3323"/>
    <Setter Property="BorderBrush" Value="#141414"/>
  </Style>
  <Style Selector="CheckBox.cute-check:checked /template/ TextBlock#CheckGlyph">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <!-- Cute Mint Paper-Airplane Archive Pill Button -->
  <Style Selector="Button.cute-archive-pill">
    <Setter Property="Background" Value="#74C69D"/>
    <Setter Property="Foreground" Value="#141414"/>
    <Setter Property="BorderBrush" Value="#141414"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.cute-archive-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#52B788"/>
    <Setter Property="Foreground" Value="#141414"/>
    <Setter Property="BorderBrush" Value="#141414"/>
  </Style>

  <!-- Cute Header Doodle Icon Button -->
  <Style Selector="Button.cute-icon-btn">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Background" Value="#8CFFFFFF"/>
    <Setter Property="BorderBrush" Value="#4D141414"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.cute-icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D9FFFFFF"/>
    <Setter Property="BorderBrush" Value="#141414"/>
  </Style>

  <!-- Realistic Drawer Buttons & Badges -->
  <Style Selector="Window.realistic Button.drawer-action-btn">
    <Setter Property="Background" Value="#33FFFFFF"/>
    <Setter Property="BorderBrush" Value="#40141414"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="Window.realistic Button.drawer-action-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#73FFFFFF"/>
    <Setter Property="BorderBrush" Value="#141414"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>

  <Style Selector="Window.realistic Button.drawer-delete-btn">
    <Setter Property="Background" Value="#22EA3323"/>
    <Setter Property="BorderBrush" Value="#4DEA3323"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#C92517"/>
  </Style>
  <Style Selector="Window.realistic Button.drawer-delete-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#40EA3323"/>
    <Setter Property="BorderBrush" Value="#EA3323"/>
    <Setter Property="Foreground" Value="#EA3323"/>
  </Style>

  <Style Selector="Window.realistic Border.meta-pill">
    <Setter Property="Background" Value="#1F000000"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Window.realistic Button.drawer-icon-btn">
    <Setter Property="Background" Value="#33FFFFFF"/>
    <Setter Property="BorderBrush" Value="#40141414"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="Window.realistic Button.drawer-icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#73FFFFFF"/>
    <Setter Property="BorderBrush" Value="#141414"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>

  <Style Selector="Window.realistic Button.drawer-danger-icon-btn">
    <Setter Property="Background" Value="#22EA3323"/>
    <Setter Property="BorderBrush" Value="#4DEA3323"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Foreground" Value="#C92517"/>
  </Style>
  <Style Selector="Window.realistic Button.drawer-danger-icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#40EA3323"/>
    <Setter Property="BorderBrush" Value="#EA3323"/>
    <Setter Property="Foreground" Value="#EA3323"/>
  </Style>

  <Style Selector="Window.realistic Border.drawer-chart-pill">
    <Setter Property="Background" Value="#1F000000"/>
    <Setter Property="BorderBrush" Value="#33141414"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- Panel Window Frame Styles -->
  <Style Selector="Border.minimal-frame">
    <Setter Property="Background" Value="{DynamicResource BgWindow}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}"/>
    <Setter Property="Padding" Value="10,8,10,6"/>
  </Style>

  <Style Selector="Border.paper-frame">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BoxShadow" Value="{StaticResource PaperStickyShadow}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Grid.paper-content">
    <Setter Property="Margin" Value="12,6,12,10"/>
  </Style>

  <!-- Title Styles for Minimalist and Realistic Modes -->
  <Style Selector="TextBox.minimal-title">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="SelectableTextBlock.minimal-title">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="TextBox.paper-title">
    <Setter Property="FontSize" Value="16.5"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="SelectableTextBlock.paper-title">
    <Setter Property="FontSize" Value="16.5"/>
    <Setter Property="Foreground" Value="#141414"/>
  </Style>
  <Style Selector="SelectableTextBlock.completed-title">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="Opacity" Value="0.65"/>
  </Style>
  <Style Selector="Window.realistic SelectableTextBlock.completed-title">
    <Setter Property="Foreground" Value="#73141414"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>


  <!-- Detail Window Container & Card Styles -->
  <Style Selector="Border.minimal-detail">
    <Setter Property="Background" Value="{DynamicResource BgWindow}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}"/>
    <Setter Property="Padding" Value="18,12,18,14"/>
  </Style>

  <Style Selector="Border.paper-detail">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BoxShadow" Value="{StaticResource PaperStickyShadow}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Grid.detail-paper-content">
    <Setter Property="Margin" Value="18,12,18,14"/>
  </Style>

  <Style Selector="Border.minimal-card">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
  </Style>

  <Style Selector="Border.paper-card">
    <Setter Property="Background" Value="#73FFFFFF"/>
    <Setter Property="BorderBrush" Value="#33141414"/>
    <Setter Property="BorderThickness" Value="1.2"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <!-- Calendar Month Cell Styles -->
  <Style Selector="Button.cal-cell-btn">
    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="MinHeight" Value="50"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.cal-cell-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
  </Style>
  <Style Selector="Button.cal-cell-btn.other-month">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <Style Selector="Button.cal-cell-btn.today">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
  </Style>
  <Style Selector="Button.cal-cell-btn.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

</Styles>

