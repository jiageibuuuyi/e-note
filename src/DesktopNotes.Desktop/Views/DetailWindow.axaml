<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:loc="using:DesktopNotes.Desktop.Localization"
        xmlns:contracts="using:DesktopNotes.Application.Contracts"
        x:Class="DesktopNotes.Desktop.Views.DetailWindow"
        x:DataType="vm:DetailViewModel"
        Width="550" Height="690" MinWidth="420" MinHeight="480"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True"
        Icon="/Assets/Icons/app-icon.ico"
        Title="{Binding Loc.DetailWindowTitle}">

  <Panel Name="DetailScenePanel" Margin="8,6,10,12">
    <!-- Main Window Border -->
    <Border Name="DetailRootBorder"
            Classes.minimal-detail="{Binding Loc.IsMinimalistStyle}"
            Classes.paper-detail="{Binding Loc.IsRealisticStyle}"
            DragDrop.AllowDrop="True">
      <Panel>
        <!-- 0. Realistic Organic Curved Paper Sheet Layer (Rendered only in Realistic Mode) -->
        <Panel Name="DetailRealisticPaperBackgroundLayer"
               IsVisible="{Binding Loc.IsRealisticStyle}"
               IsHitTestVisible="False">
          <!-- Hand-drawn natural curved paper shape (Cubic Bezier contours on all 4 edges) -->
          <Path Name="DetailRealisticPaperPath"
                Data="M 16,7 C 105,3 255,8 344,4 C 352,5 356,11 356,20 C 354,140 358,310 354,456 C 353,468 345,486 320,494 C 230,499 100,492 16,496 C 8,495.5 3.5,490 4,480 C 5.5,315 2.5,145 5,20 C 5.5,10 10,7 16,7 Z"
                Fill="{StaticResource PaperWarmGradient}"
                Stroke="#C9A11E"
                StrokeThickness="1.5"
                Stretch="Fill" />

          <!-- Bottom subtle creases -->
          <Canvas VerticalAlignment="Bottom" Height="25" Margin="30,0,55,5" Opacity="0.22">
            <Line StartPoint="0,12" EndPoint="42,10" Stroke="#141414" StrokeThickness="1.4" StrokeLineCap="Round" />
            <Line StartPoint="52,10" EndPoint="85,12" Stroke="#141414" StrokeThickness="1.4" StrokeLineCap="Round" />
          </Canvas>

          <!-- Authentic 3D Corner Peel Flap in Bottom Right -->
          <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="44" Height="44">
            <!-- Under-peel dark shadow -->
            <Polygon Points="44,0 0,44 44,44" Fill="#BD9615" Opacity="0.9" />
            <!-- Lifted lighter corner flap with natural peel curve -->
            <Path Data="M 0,44 Q 20,24 44,0 Q 28,32 0,44 Z" Fill="#FFF9DA" Stroke="#C9A11E" StrokeThickness="1.2" />
            <!-- Diagonal fold crease line -->
            <Line StartPoint="0,44" EndPoint="44,0" Stroke="#B89014" StrokeThickness="1.5" StrokeLineCap="Round" />
          </Canvas>
        </Panel>

        <!-- Foreground Content Grid -->
        <Grid Classes.detail-paper-content="{Binding Loc.IsRealisticStyle}"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <!-- 0. Top Center Pushpin (Realistic Mode Only) -->
        <Grid Grid.Row="0"
              IsVisible="{Binding Loc.IsRealisticStyle}"
              HorizontalAlignment="Center"
              Height="28"
              Margin="0,0,0,1">
          <Canvas Width="34" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Canvas.Left="13" Canvas.Top="22" Width="13" Height="4.5" Fill="#3D141414"/>
            <Path Data="M14 24.5 Q17 26 20 24.5" Stroke="#141414" StrokeThickness="1.5" StrokeLineCap="Round" Opacity="0.55"/>
            <Path Data="M17 17.5 L17 24.5" Stroke="#141414" StrokeThickness="2.5" StrokeLineCap="Round"/>
            <Ellipse Canvas.Left="8" Canvas.Top="1.5" Width="18" Height="18" Fill="#EA3323" Stroke="#141414" StrokeThickness="2"/>
            <Path Data="M10 13.5 A7.8 7.8 0 0 0 24 13.5" Stroke="#B81B0E" StrokeThickness="2.2" StrokeLineCap="Round"/>
            <Ellipse Canvas.Left="10.5" Canvas.Top="5" Width="6.2" Height="3.4" Fill="#F2FFFFFF">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="-28"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Canvas>
        </Grid>

        <!-- 0.5 Glue Crease Line (Realistic Mode Only) -->
        <Border Grid.Row="0"
                IsVisible="{Binding Loc.IsRealisticStyle}"
                Height="1.5"
                VerticalAlignment="Bottom"
                CornerRadius="1"
                Background="#73B58D12"
                Margin="4,0,4,0"/>

        <!-- 1. Header Bar: Kind Badge, Status Message & Close Button -->
        <Grid Name="DetailHeaderRegion"
              Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              Background="Transparent"
              Margin="0,4,0,8">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSubtle}"
                    CornerRadius="6"
                    Padding="8,2.5">
              <TextBlock Text="{Binding RecordKindTitle}"
                         Foreground="{DynamicResource AccentPrimary}"
                         FontSize="12"
                         FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11.5"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <Button Name="BtnHeaderClose"
                  Grid.Column="2"
                  Classes="icon-ghost"
                  Width="24" Height="24"
                  ToolTip.Tip="{Binding Loc.DetailCloseTooltip}">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 L 19 6.41 Z"/>
          </Button>
        </Grid>

        <!-- 2. Document Title Input -->
        <Border Grid.Row="2"
                Classes.minimal-card="{Binding Loc.IsMinimalistStyle}"
                Classes.paper-card="{Binding Loc.IsRealisticStyle}"
                Padding="12,6"
                Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0"
                       Text="{Binding Loc.DetailTitleLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Width="48"/>
            <TextBox Name="TitleBox"
                     Grid.Column="1"
                     Classes="clean-input"
                     Classes.paper-title="{Binding Loc.IsRealisticStyle}"
                     Classes.minimal-title="{Binding Loc.IsMinimalistStyle}"
                     Text="{Binding Title}"
                     PlaceholderText="{Binding Loc.DetailTitlePlaceholder}"
                     FontWeight="SemiBold"/>
          </Grid>
        </Border>

        <!-- 3. Structured Task Properties (Tasks Only) -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsTaskKind}"
                Classes.minimal-card="{Binding Loc.IsMinimalistStyle}"
                Classes.paper-card="{Binding Loc.IsRealisticStyle}"
                Padding="12,8"
                Margin="0,0,0,8">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="7">
            <!-- Row 0: Priority Selector -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Loc.DetailPriorityLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Width="68"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnPrio0" Classes="seg-pill" Classes.active="{Binding IsPriorityP0}" Padding="8,2" FontSize="11.5" Content="{Binding Loc.DetailPrio0}"/>
              <Button Name="BtnPrio1" Classes="seg-pill" Classes.active="{Binding IsPriorityP1}" Padding="8,2" FontSize="11.5" Content="{Binding Loc.DetailPrio1}"/>
              <Button Name="BtnPrio2" Classes="seg-pill" Classes.active="{Binding IsPriorityP2}" Padding="8,2" FontSize="11.5" Content="{Binding Loc.DetailPrio2}"/>
              <Button Name="BtnPrio3" Classes="seg-pill" Classes.active="{Binding IsPriorityP3}" Padding="8,2" FontSize="11.5" Content="{Binding Loc.DetailPrio3}"/>
            </StackPanel>

            <!-- Row 1: Due Date (Deadline) -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{Binding Loc.DetailDueLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="7,2"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding DueDisplayText}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="Medium"/>
              </Border>
              <Button Name="BtnDueToday" Classes="seg-pill" Padding="6,2" Margin="0,0,4,0" FontSize="11" Content="{Binding Loc.DetailDueToday}"/>
              <Button Name="BtnDueTomorrow" Classes="seg-pill" Padding="6,2" Margin="0,0,4,0" FontSize="11" Content="{Binding Loc.DetailDueTomorrow}"/>
              <Button Name="BtnDueNextWeek" Classes="seg-pill" Padding="6,2" Margin="0,0,6,0" FontSize="11" Content="{Binding Loc.DetailDueNextWeek}"/>
              <CalendarDatePicker Name="DueDatePicker"
                                  SelectedDate="{Binding SelectedDueDate}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="yyyy-MM-dd"
                                  PlaceholderText="{Binding Loc.DetailDuePickPlaceholder}"
                                  FontSize="11"
                                  MinWidth="105"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
              <Button Name="BtnClearDue"
                      IsVisible="{Binding HasDue}"
                      Classes="ghost-link"
                      Content="{Binding Loc.DetailClearBtn}"
                      FontSize="11"
                      VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Row 2: Start Date -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding Loc.DetailStartLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="7,2"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding StartDisplayText}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11.5"/>
              </Border>
              <Button Name="BtnStartToday" Classes="seg-pill" Padding="6,2" FontSize="11" Content="{Binding Loc.DetailStartSetToday}"/>
              <CalendarDatePicker Name="StartDatePicker"
                                  SelectedDate="{Binding SelectedStartDate}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="yyyy-MM-dd"
                                  PlaceholderText="{Binding Loc.DetailStartPickPlaceholder}"
                                  FontSize="11"
                                  MinWidth="105"
                                  VerticalAlignment="Center"/>
              <Button Name="BtnClearStart"
                      IsVisible="{Binding HasStart}"
                      Classes="ghost-link"
                      Content="{Binding Loc.DetailClearBtn}"
                      FontSize="11"
                      VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: Assignee & Publisher -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{Binding Loc.DetailPeopleLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,10,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="8,2">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Loc.DetailAssigneeLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBox Name="AssigneeBox"
                           Grid.Column="1"
                           Classes="clean-input"
                           Text="{Binding AssigneeText}"
                           PlaceholderText="{Binding Loc.DetailAssigneePlaceholder}"
                           FontSize="12"/>
                </Grid>
              </Border>

              <Border Grid.Column="2"
                      Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="8,2">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Loc.DetailPublisherLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBox Name="PublisherBox"
                           Grid.Column="1"
                           Classes="clean-input"
                           Text="{Binding PublisherText}"
                           PlaceholderText="{Binding Loc.DetailPublisherPlaceholder}"
                           FontSize="12"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- 4. Document Body Multi-line Editor -->
        <Border Grid.Row="4"
                Classes.minimal-card="{Binding Loc.IsMinimalistStyle}"
                Classes.paper-card="{Binding Loc.IsRealisticStyle}"
                Padding="12,8"
                Margin="0,0,0,8">
          <TextBox Name="BodyBox"
                   Classes="clean-input"
                   Text="{Binding Body}"
                   PlaceholderText="{Binding Loc.DetailBodyPlaceholder}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   VerticalContentAlignment="Top"
                   FontSize="13.5"
                   LineHeight="21"/>
        </Border>

        <!-- 5. Subtasks & Attachment Storage Path Panel -->
        <StackPanel Grid.Row="5" Spacing="6" Margin="0,0,0,8">
          <!-- Subtasks Panel (Only for Root Tasks) -->
          <Border IsVisible="{Binding CanHaveSubtasks}"
                  Classes.minimal-card="{Binding Loc.IsMinimalistStyle}"
                  Classes.paper-card="{Binding Loc.IsRealisticStyle}"
                  Padding="12,7">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Loc.DetailSubtasksLabel}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Border Grid.Column="1"
                        Background="{DynamicResource BgSubtle}"
                        CornerRadius="5"
                        Padding="8,2"
                        Margin="0,0,6,0">
                  <TextBox Name="NewSubtaskBox"
                           Classes="clean-input"
                           Text="{Binding NewSubtaskTitle}"
                           PlaceholderText="{Binding Loc.DetailSubtaskInputPlaceholder}"
                           FontSize="12"/>
                </Border>
                <Button Name="BtnAddSubtask"
                        Grid.Column="2"
                        Classes="ghost-link"
                        FontSize="11.5"
                        Content="{Binding Loc.DetailAddSubtaskBtn}"/>
              </Grid>

              <ItemsControl ItemsSource="{Binding Subtasks}"
                            IsVisible="{Binding HasSubtasks}"
                            MaxHeight="85">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="contracts:RecordView">
                    <Border Background="{DynamicResource BgSubtle}"
                            CornerRadius="5"
                            Padding="8,2.5"
                            Margin="0,1.5">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="🌱 "
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayTitle}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2"
                                Classes="ghost-link"
                                FontSize="11"
                                Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=DetailSubtaskDoneBtn}"
                                Tag="{Binding Id}"
                                Click="OnCompleteSubtaskItemClick"/>
                        <Button Grid.Column="3"
                                Classes="ghost-link"
                                FontSize="11"
                                Content="✕"
                                Tag="{Binding Id}"
                                Click="OnRemoveSubtaskItemClick"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Attachments Panel -->
          <Border Classes.minimal-card="{Binding Loc.IsMinimalistStyle}"
                  Classes.paper-card="{Binding Loc.IsRealisticStyle}"
                  Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding Loc.DetailFilesLabel}"
                         Foreground="{DynamicResource TextMuted}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding AttachmentRootPathText}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <Button Name="BtnSelectAttachmentFolder"
                      Grid.Column="2"
                      Classes="ghost-link"
                      FontSize="11"
                      Margin="4,0"
                      Content="{Binding Loc.DetailSelectFolderBtn}"/>
              <Button Name="BtnOpenAttachmentFolder"
                      Grid.Column="3"
                      Classes="ghost-link"
                      FontSize="11"
                      Margin="4,0"
                      Content="{Binding Loc.DetailOpenFolderBtn}"/>
              <Button Name="BtnAddAttachmentFiles"
                      Grid.Column="4"
                      Classes="ghost-link"
                      FontSize="11"
                      Content="{Binding Loc.DetailAddFilesBtn}"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- 6. Bottom Action Bar: Save & Close, Close, Archive, Delete -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2,0,0">
          <Button Name="BtnTrashDetail"
                  Grid.Column="0"
                  Classes="ghost-link"
                  Foreground="{DynamicResource StatusOverdue}"
                  Content="{Binding Loc.DetailDeleteBtn}"/>
          <Button Name="BtnArchiveDetail"
                  Grid.Column="1"
                  Classes="ghost-link"
                  Margin="6,0,0,0"
                  Content="{Binding Loc.RowArchiveBtn}"/>
          <Button Name="BtnClose"
                  Grid.Column="3"
                  Classes="secondary-pill"
                  Margin="0,0,8,0"
                  Content="{Binding Loc.DetailCloseBtn}"/>
          <Button Name="BtnSave"
                  Grid.Column="4"
                  Classes="primary-pill"
                  Content="{Binding Loc.DetailSaveBtn}"/>
        </Grid>

        </Grid>
      </Panel>
    </Border>

  </Panel>
</Window>
