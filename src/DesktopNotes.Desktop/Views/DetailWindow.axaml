<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:loc="using:DesktopNotes.Desktop.Localization"
        xmlns:contracts="using:DesktopNotes.Application.Contracts"
        x:Class="DesktopNotes.Desktop.Views.DetailWindow"
        x:DataType="vm:DetailViewModel"
        Width="540" Height="680" MinWidth="420" MinHeight="480"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True"
        Title="{Binding Loc.DetailWindowTitle}">
  <Border Name="DetailRootBorder"
          BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="20,14,20,14"
          DragDrop.AllowDrop="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <!-- 1. Header Drag Bar with Draft Status & Close -->
      <Grid Name="DetailHeaderRegion"
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto"
            Background="Transparent"
            Margin="0,0,0,10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentSubtle}"
                  CornerRadius="5"
                  Padding="7,2.5">
            <TextBlock Text="{Binding RecordKindTitle}"
                       Foreground="{DynamicResource AccentPrimary}"
                       FontSize="11.5"
                       FontWeight="SemiBold"/>
          </Border>
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11.5"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <Button Name="BtnHeaderClose"
                Grid.Column="2"
                Classes="icon-ghost"
                Width="26" Height="26"
                ToolTip.Tip="{Binding Loc.DetailCloseTooltip}">
          <PathIcon Width="11" Height="11"
                    Foreground="{DynamicResource TextMuted}"
                    Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 L 19 6.41 Z"/>
        </Button>
      </Grid>

      <!-- 2. Document Title Input & Structured Properties (Structured Properties shown only for Tasks) -->
      <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,10">
        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6"
                BoxShadow="{DynamicResource CardShadow}">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0"
                       Text="{Binding Loc.DetailTitleLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Width="48"/>
            <TextBox Name="TitleBox"
                     Grid.Column="1"
                     Classes="clean-input"
                     Text="{Binding Title}"
                     PlaceholderText="{Binding Loc.DetailTitlePlaceholder}"
                     FontSize="15.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>
          </Grid>
        </Border>

        <!-- Structured Task Properties Card: Priority, Due, Start, Assignee & Publisher (Hidden for Notes!) -->
        <Border IsVisible="{Binding IsTaskKind}"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,9"
                BoxShadow="{DynamicResource CardShadow}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8">
            <!-- Row 0: Priority Selector -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Loc.DetailPriorityLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Width="68"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnPrio0" Classes="seg-pill" Classes.active="{Binding IsPriorityP0}" Padding="8,2.5" FontSize="11.5" Content="{Binding Loc.DetailPrio0}"/>
              <Button Name="BtnPrio1" Classes="seg-pill" Classes.active="{Binding IsPriorityP1}" Padding="8,2.5" FontSize="11.5" Content="{Binding Loc.DetailPrio1}"/>
              <Button Name="BtnPrio2" Classes="seg-pill" Classes.active="{Binding IsPriorityP2}" Padding="8,2.5" FontSize="11.5" Content="{Binding Loc.DetailPrio2}"/>
              <Button Name="BtnPrio3" Classes="seg-pill" Classes.active="{Binding IsPriorityP3}" Padding="8,2.5" FontSize="11.5" Content="{Binding Loc.DetailPrio3}"/>
            </StackPanel>

            <!-- Row 1: Due Date (Deadline) -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{Binding Loc.DetailDueLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="7,2.5"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding DueDisplayText}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="Medium"/>
              </Border>
              <Button Name="BtnDueToday" Classes="seg-pill" Padding="6,2" Margin="0,0,4,0" FontSize="11" Content="{Binding Loc.DetailDueToday}"/>
              <Button Name="BtnDueTomorrow" Classes="seg-pill" Padding="6,2" Margin="0,0,4,0" FontSize="11" Content="{Binding Loc.DetailDueTomorrow}"/>
              <Button Name="BtnDueNextWeek" Classes="seg-pill" Padding="6,2" Margin="0,0,6,0" FontSize="11" Content="{Binding Loc.DetailDueNextWeek}"/>
              <CalendarDatePicker Name="DueDatePicker"
                                  SelectedDate="{Binding SelectedDueDate}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="yyyy-MM-dd"
                                  PlaceholderText="{Binding Loc.DetailDuePickPlaceholder}"
                                  FontSize="11"
                                  MinWidth="105"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
              <Button Name="BtnClearDue"
                      IsVisible="{Binding HasDue}"
                      Classes="ghost-link"
                      Content="{Binding Loc.DetailClearBtn}"
                      FontSize="11"
                      VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Row 2: Start Date -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding Loc.DetailStartLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="7,2.5"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding StartDisplayText}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11.5"/>
              </Border>
              <Button Name="BtnStartToday" Classes="seg-pill" Padding="6,2" FontSize="11" Content="{Binding Loc.DetailStartSetToday}"/>
              <CalendarDatePicker Name="StartDatePicker"
                                  SelectedDate="{Binding SelectedStartDate}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="yyyy-MM-dd"
                                  PlaceholderText="{Binding Loc.DetailStartPickPlaceholder}"
                                  FontSize="11"
                                  MinWidth="105"
                                  VerticalAlignment="Center"/>
              <Button Name="BtnClearStart"
                      IsVisible="{Binding HasStart}"
                      Classes="ghost-link"
                      Content="{Binding Loc.DetailClearBtn}"
                      FontSize="11"
                      VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: Assignee & Publisher -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{Binding Loc.DetailPeopleLabel}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,12,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="8,2">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Loc.DetailAssigneeLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Name="AssigneeBox"
                           Grid.Column="1"
                           Classes="clean-input"
                           Text="{Binding AssigneeText}"
                           PlaceholderText="{Binding Loc.DetailAssigneePlaceholder}"
                           FontSize="12"/>
                </Grid>
              </Border>

              <Border Grid.Column="2"
                      Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="8,2">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Loc.DetailPublisherLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Name="PublisherBox"
                           Grid.Column="1"
                           Classes="clean-input"
                           Text="{Binding PublisherText}"
                           PlaceholderText="{Binding Loc.DetailPublisherPlaceholder}"
                           FontSize="12"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 3. Document Body Multi-line Editor (Details) -->
      <Border Grid.Row="2"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="9"
              Padding="12,10"
              Margin="0,0,0,10"
              BoxShadow="{DynamicResource CardShadow}">
        <TextBox Name="BodyBox"
                 Classes="clean-input"
                 Text="{Binding Body}"
                 PlaceholderText="{Binding Loc.DetailBodyPlaceholder}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 FontSize="13"
                 LineHeight="21"/>
      </Border>

      <!-- 4. Subtasks & Attachment Storage Path Panel -->
      <StackPanel Grid.Row="3" Spacing="8">
        <!-- Subtasks Panel (Only for Root Tasks) -->
        <Border IsVisible="{Binding CanHaveSubtasks}"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,8"
                BoxShadow="{DynamicResource CardShadow}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding Loc.DetailSubtasksLabel}"
                         Foreground="{DynamicResource TextMuted}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <Border Grid.Column="1"
                      Background="{DynamicResource BgSubtle}"
                      CornerRadius="5"
                      Padding="8,2"
                      Margin="0,0,6,0">
                <TextBox Name="NewSubtaskBox"
                         Classes="clean-input"
                         Text="{Binding NewSubtaskTitle}"
                         PlaceholderText="{Binding Loc.DetailSubtaskInputPlaceholder}"
                         FontSize="12"/>
              </Border>
              <Button Name="BtnAddSubtask"
                      Grid.Column="2"
                      Classes="ghost-link"
                      FontSize="11.5"
                      Content="{Binding Loc.DetailAddSubtaskBtn}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Subtasks}"
                          IsVisible="{Binding HasSubtasks}"
                          MaxHeight="95">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:RecordView">
                  <Border Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="8,3"
                          Margin="0,2">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="↳ "
                                 Foreground="{DynamicResource TextMuted}"
                                 FontSize="11.5"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding DisplayTitle}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="11.5"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="2"
                              Classes="ghost-link"
                              FontSize="11"
                              Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=DetailSubtaskDoneBtn}"
                              Tag="{Binding Id}"
                              Click="OnCompleteSubtaskItemClick"/>
                      <Button Grid.Column="3"
                              Classes="ghost-link"
                              FontSize="11"
                              Foreground="{DynamicResource StatusOverdue}"
                              Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=DetailDeleteBtn}"
                              Tag="{Binding Id}"
                              Click="OnRemoveSubtaskItemClick"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Attachment Storage Path & Drag-Drop Files Panel -->
        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,8"
                BoxShadow="{DynamicResource CardShadow}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding Loc.DetailFilesLabel}"
                         Foreground="{DynamicResource TextMuted}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding AttachmentRootPathText}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding AttachmentRootPathText}"/>
              <Button Name="BtnSelectAttachmentFolder"
                      Grid.Column="2"
                      Classes="ghost-link"
                      FontSize="11.5"
                      Content="{Binding Loc.DetailSelectFolderBtn}"
                      ToolTip.Tip="{Binding Loc.DetailSelectFolderTooltip}"/>
              <Button Name="BtnOpenAttachmentFolder"
                      Grid.Column="3"
                      Classes="ghost-link"
                      FontSize="11.5"
                      Content="{Binding Loc.DetailOpenFolderBtn}"/>
              <Button Name="BtnAddAttachmentFiles"
                      Grid.Column="4"
                      Classes="ghost-link"
                      FontSize="11.5"
                      Content="{Binding Loc.DetailAddFilesBtn}"/>
            </Grid>

            <!-- Linked Attachments List -->
            <ItemsControl ItemsSource="{Binding Attachments}"
                          IsVisible="{Binding HasAttachments}"
                          MaxHeight="95">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:AttachmentView">
                  <Border Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="8,3"
                          Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding OriginalName}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="11.5"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1"
                              Classes="ghost-link"
                              FontSize="11"
                              Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=DetailFileOpenBtn}"
                              Tag="{Binding Id}"
                              Click="OnOpenAttachmentItemClick"/>
                      <Button Grid.Column="2"
                              Classes="ghost-link"
                              FontSize="11"
                              Foreground="{DynamicResource StatusOverdue}"
                              Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=DetailFileRemoveBtn}"
                              Tag="{Binding Id}"
                              Click="OnRemoveAttachmentItemClick"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock IsVisible="{Binding !HasAttachments}"
                       Text="{Binding Loc.DetailDropHint}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,2"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 5. Bottom Action Bar (Includes Archive & Delete + Close & Save) -->
      <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
        <StackPanel Grid.Column="0"
                    IsVisible="{Binding CanArchiveOrTrash}"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Button Name="BtnArchiveDetail"
                  Classes="secondary-pill"
                  Padding="10,4"
                  FontSize="11.5"
                  Content="{Binding Loc.DetailArchiveRecordBtn}"/>
          <Button Name="BtnTrashDetail"
                  Classes="secondary-pill"
                  Padding="10,4"
                  FontSize="11.5"
                  Foreground="{DynamicResource StatusOverdue}"
                  Content="{Binding Loc.DetailTrashRecordBtn}"/>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding Loc.DetailFooterHint}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   Margin="10,0"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Name="BtnClose"
                  Classes="secondary-pill"
                  Content="{Binding Loc.DetailCloseBtn}"/>
          <Button Name="BtnSave"
                  Classes="primary-pill"
                  Content="{Binding Loc.DetailSaveBtn}"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
