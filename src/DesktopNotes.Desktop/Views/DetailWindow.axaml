<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        x:Class="DesktopNotes.Desktop.Views.DetailWindow"
        x:DataType="vm:DetailViewModel"
        Width="480" Height="560" MinWidth="360" MinHeight="420"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Title="记录详情">
  <Border BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="22,18,22,16">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 1. Draggable Sheet Header & Document-Style Title Input -->
      <Grid Name="DetailHeaderRegion"
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Background="Transparent"
            Margin="0,0,0,10">
        <TextBox Name="TitleBox"
                 Grid.Column="0"
                 Classes="clean-input"
                 Text="{Binding Title}"
                 PlaceholderText="无标题记录..."
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11.5"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>
      </Grid>

      <!-- 2. Metadata Pill Strip -->
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,0,0,1"
              Padding="0,0,0,12"
              Margin="0,0,0,12">
        <WrapPanel Orientation="Horizontal">
          <Border Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8,4"
                  Margin="0,0,6,6">
            <TextBlock Text="{Binding Effective.Priority, StringFormat='优先级 · {0}'}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"/>
          </Border>

          <Border Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8,4"
                  Margin="0,0,6,6">
            <TextBlock Text="{Binding Effective.Assignee, StringFormat='责任人 · {0}', TargetNullValue='责任人 · 未指定'}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"/>
          </Border>

          <Button Name="BtnClearDue"
                  Classes="ghost-link"
                  Content="设为无截止 ×"
                  Margin="0,0,0,6"/>
        </WrapPanel>
      </Border>

      <!-- 3. Clean Document Body Editor -->
      <Border Grid.Row="2"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,12">
        <TextBox Name="BodyBox"
                 Classes="clean-input"
                 Text="{Binding Body}"
                 PlaceholderText="输入详细描述、会议纪要或子步骤..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 FontSize="13.5"/>
      </Border>

      <!-- 4. Bottom Action Bar -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
        <TextBlock Grid.Column="0"
                   Text="修改停止 500ms 自动暂存草稿 · Esc 关闭"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11.5"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="BtnClose"
                  Classes="secondary-pill"
                  Content="关闭"/>
          <Button Name="BtnSave"
                  Classes="primary-pill"
                  Content="保存修改"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
