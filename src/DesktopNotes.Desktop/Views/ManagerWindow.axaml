<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:loc="using:DesktopNotes.Desktop.Localization"
        xmlns:contracts="using:DesktopNotes.Application.Contracts"
        x:Class="DesktopNotes.Desktop.Views.ManagerWindow"
        x:DataType="vm:CalendarViewModel"
        Width="740" Height="600" MinWidth="560" MinHeight="460"
        Background="{DynamicResource BgWindow}"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Loc.ManagerWindowTitle}">
  <Border Padding="20,16">
    <TabControl Name="MainTabControl" Background="Transparent">

      <!-- Tab 1: Live Task Calendar -->
      <TabItem Header="{Binding Loc.TabCalendar}" FontSize="13.5">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
          <!-- Month Switcher Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding YearMonthTitle}"
                         FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"
                         VerticalAlignment="Center"/>
              <Border Background="{DynamicResource AccentSubtle}"
                      CornerRadius="5"
                      Padding="8,2.5"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding MonthEntriesBadgeText}"
                           Foreground="{DynamicResource AccentPrimary}"
                           FontSize="11.5"
                           FontWeight="Medium"/>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnPrevMonth" Classes="secondary-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.CalPrevMonth}"/>
              <Button Name="BtnTodayMonth" Classes="secondary-pill" Padding="12,4" FontSize="12" Content="{Binding Loc.CalThisMonth}"/>
              <Button Name="BtnNextMonth" Classes="secondary-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.CalNextMonth}"/>
            </StackPanel>
          </Grid>

          <!-- Calendar Axis Selector -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="{Binding Loc.CalViewByLabel}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Button Name="BtnAxisDue" Classes="seg-pill" Classes.active="{Binding IsAxisDue}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisDue}"/>
            <Button Name="BtnAxisStart" Classes="seg-pill" Classes.active="{Binding IsAxisStart}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisStart}"/>
            <Button Name="BtnAxisCreated" Classes="seg-pill" Classes.active="{Binding IsAxisCreated}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisCreated}"/>
            <Button Name="BtnAxisClosed" Classes="seg-pill" Classes.active="{Binding IsAxisClosed}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisClosed}"/>
          </StackPanel>

          <!-- Calendar Task Entries List -->
          <Border Grid.Row="2"
                  Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12"
                  BoxShadow="{DynamicResource CardShadow}">
            <Panel>
              <ScrollViewer IsVisible="{Binding HasMonthEntries}">
                <ItemsControl ItemsSource="{Binding MonthEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:CalendarEntry">
                      <Border Background="{DynamicResource BgSubtle}"
                              CornerRadius="7"
                              Padding="12,8"
                              Margin="0,3">
                        <Grid ColumnDefinitions="95,*,Auto,Auto">
                          <Border Grid.Column="0"
                                  Background="{DynamicResource BgCard}"
                                  CornerRadius="5"
                                  Padding="6,2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Day, TargetNullValue='—'}"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"/>
                          </Border>

                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="6,0">
                            <TextBlock Text="{Binding Record.DisplayTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Record.Body}"
                                       IsVisible="{Binding Record.Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <TextBlock Grid.Column="2"
                                     Text="{Binding Record.Effective.Assignee, StringFormat='👤 {0}'}"
                                     IsVisible="{Binding Record.Effective.Assignee, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     Margin="8,0"/>

                          <Border Grid.Column="3"
                                  Background="{DynamicResource BgHover}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Record.Status}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding !HasMonthEntries}"
                          Spacing="10"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <PathIcon Width="32" Height="32"
                          Foreground="{DynamicResource TextMuted}"
                          Data="M 19 4 L 18 4 L 18 2 L 16 2 L 16 4 L 8 4 L 8 2 L 6 2 L 6 4 L 5 4 A 2 2 0 0 0 3 6 L 3 20 A 2 2 0 0 0 5 22 L 19 22 A 2 2 0 0 0 21 20 L 21 6 A 2 2 0 0 0 19 4 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 19 8 L 5 8 L 5 6 L 19 6 L 19 8 Z"/>
                <TextBlock Text="{Binding Loc.CalEmptyTitle}"
                           FontSize="13.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Loc.CalEmptySubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Tab 2: Historical Archive & Trash -->
      <TabItem Header="{Binding Loc.TabArchiveTrash}" FontSize="13.5">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <!-- Filter & Search Bar -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,220" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnShowArchived"
                      Classes="seg-pill"
                      Classes.active="{Binding IsArchiveView}"
                      Padding="12,4"
                      FontSize="12"
                      Content="{Binding Loc.HistArchivedBtn}"/>
              <Button Name="BtnShowTrash"
                      Classes="seg-pill"
                      Classes.active="{Binding IsTrashView}"
                      Padding="12,4"
                      FontSize="12"
                      Content="{Binding Loc.HistTrashBtn}"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3">
              <TextBox Name="HistorySearchBox"
                       Classes="clean-input"
                       Text="{Binding HistorySearchText}"
                       PlaceholderText="{Binding Loc.HistSearchPlaceholder}"
                       FontSize="12"/>
            </Border>
          </Grid>

          <!-- Historical Records List -->
          <Border Grid.Row="1"
                  Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12"
                  BoxShadow="{DynamicResource CardShadow}">
            <Panel>
              <ScrollViewer IsVisible="{Binding HasHistoricalItems}">
                <ItemsControl ItemsSource="{Binding HistoricalItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:RecordView">
                      <Border Background="{DynamicResource BgSubtle}"
                              CornerRadius="7"
                              Padding="12,8"
                              Margin="0,3">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Body}"
                                       IsVisible="{Binding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding ClosedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                     IsVisible="{Binding ClosedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Foreground="{DynamicResource TextMuted}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="10,0"/>

                          <Button Grid.Column="2"
                                  Classes="ghost-link"
                                  FontSize="11.5"
                                  Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistReopenBtn}"
                                  Tag="{Binding Id}"
                                  IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNull}}"
                                  Click="OnReopenRecordClick"
                                  ToolTip.Tip="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistReopenTooltip}"/>

                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-link"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource StatusOverdue}"
                                    Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistDeleteBtn}"
                                    Tag="{Binding Id}"
                                    IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNull}}"
                                    Click="OnTrashRecordClick"/>
                            <Button Classes="ghost-link"
                                    FontSize="11.5"
                                    Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistRestoreBtn}"
                                    Tag="{Binding Id}"
                                    IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Click="OnRestoreRecordClick"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding !HasHistoricalItems}"
                          Spacing="10"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <PathIcon Width="32" Height="32"
                          Foreground="{DynamicResource TextMuted}"
                          Data="M 6 19 A 2 2 0 0 0 8 21 L 16 21 A 2 2 0 0 0 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"/>
                <TextBlock Text="{Binding Loc.HistEmptyTitle}"
                           FontSize="13.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Loc.HistEmptySubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Tab 3: Settings & Backup -->
      <TabItem Header="{Binding Loc.TabSettings}" FontSize="13.5">
        <ScrollViewer Margin="0,12,0,0">
          <StackPanel Spacing="12">
            <!-- 1. Language & Time Zone Card -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Loc.SetLangSectionTitle}"
                             FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalAlignment="Center"/>
                  <Border Grid.Column="1"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="8,3"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc.DetectedTimeZoneSummary}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11.5"/>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLangLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLangDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnLangEn"
                            Classes="seg-pill"
                            Classes.active="{Binding Loc.IsEnglish}"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetLangEnBtn}"/>
                    <Button Name="BtnLangZh"
                            Classes="seg-pill"
                            Classes.active="{Binding Loc.IsChinese}"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetLangZhBtn}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 2. Window & Desktop Placement -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetWindowSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLayerLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLayerDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnModeTopmost" Classes="seg-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.SetModeTopmostBtn}"/>
                    <Button Name="BtnModeDesktop" Classes="seg-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.SetModeDesktopBtn}"/>
                  </StackPanel>
                </Grid>

                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,2"/>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLockLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLockDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <CheckBox Name="CheckLockPosition"
                            Grid.Column="1"
                            Classes="task-check"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,2"/>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetStartupLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetStartupDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <CheckBox Name="CheckLaunchAtLogin"
                            Grid.Column="1"
                            Classes="task-check"
                            VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 3. Global Default Attachment Storage Directory -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetAttachmentSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Loc.SetAttachmentDesc}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                  <Border Grid.Column="0"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="6"
                          Padding="10,6"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                    <TextBlock Name="GlobalAttachmentPathText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <Button Name="BtnChangeGlobalAttachmentPath"
                          Grid.Column="1"
                          Classes="secondary-pill"
                          Padding="12,5"
                          FontSize="12"
                          Margin="0,0,6,0"
                          Content="{Binding Loc.SetChangeFolderBtn}"/>
                  <Button Name="BtnOpenGlobalAttachmentPath"
                          Grid.Column="2"
                          Classes="secondary-pill"
                          Padding="12,5"
                          FontSize="12"
                          Content="{Binding Loc.SetOpenFolderBtn}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 4. Backup & Restore -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetBackupSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Loc.SetBackupDesc}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button Name="BtnExportBackup"
                          Classes="secondary-pill"
                          Content="{Binding Loc.SetExportBackupBtn}"/>
                  <Button Name="BtnRestoreBackup"
                          Classes="secondary-pill"
                          Content="{Binding Loc.SetRestoreBackupBtn}"/>
                  <TextBlock Name="SettingsStatusText"
                             Foreground="{DynamicResource AccentPrimary}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Border>
</Window>
