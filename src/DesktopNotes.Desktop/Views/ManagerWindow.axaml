<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopNotes.Desktop.Views.ManagerWindow"
        Width="720" Height="520" MinWidth="540" MinHeight="400"
        Background="{DynamicResource BgWindow}"
        WindowStartupLocation="CenterOwner"
        Title="桌面笔记 · 日历与设置">
  <Grid Margin="18">
    <TabControl>
      <TabItem Header="月历视图" FontSize="13.5">
        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,10,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="四维月历视图（截止 / 开始 / 创建 / 完成）"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="按本地自然月半开区间展示待办事项与无日期清单，已完成事项固定展示完成时快照。"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="归档与回收站" FontSize="13.5">
        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,10,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="已完成归档与逻辑回收区"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="支持按批次恢复父子任务及逻辑回收附件，不主动删除用户磁盘文件。"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="设置与备份" FontSize="13.5">
        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,10,0,0">
          <StackPanel Spacing="10">
            <TextBlock Text="偏好设置与完整备份恢复"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="支持配置默认附件根目录、桌面嵌入/置顶模式、窗口位置锁定、登录自动启动，以及带 SHA-256 校验的完整数据导出与跨目录恢复。"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
