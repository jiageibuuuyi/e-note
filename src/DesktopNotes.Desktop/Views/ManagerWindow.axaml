<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:loc="using:DesktopNotes.Desktop.Localization"
        xmlns:contracts="using:DesktopNotes.Application.Contracts"
        x:Class="DesktopNotes.Desktop.Views.ManagerWindow"
        x:DataType="vm:CalendarViewModel"
        Width="760" Height="660" MinWidth="580" MinHeight="480"
        Background="{DynamicResource BgWindow}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://DesktopNotes.Desktop/Assets/Icons/app-icon.ico"
        Title="{Binding Loc.ManagerWindowTitle}">
  <Panel>
    <Border Padding="20,16">
    <TabControl Name="MainTabControl" Background="Transparent">

      <!-- Tab 1: Live Task Calendar (月历形式 + 悬浮窗显示任务 + 创建与完成标记) -->
      <TabItem Header="{Binding Loc.TabCalendar}" FontSize="13.5">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
          <!-- Month Switcher Header & View Switcher -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding YearMonthTitle}"
                         FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"
                         VerticalAlignment="Center"/>
              <Border Background="{DynamicResource AccentSubtle}"
                      CornerRadius="5"
                      Padding="8,2.5"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding MonthEntriesBadgeText}"
                           Foreground="{DynamicResource AccentPrimary}"
                           FontSize="11.5"
                           FontWeight="Medium"/>
              </Border>

              <!-- View Switcher: Month Grid vs List -->
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                <Button Name="BtnViewMonthGrid"
                        Classes="seg-pill"
                        Classes.active="{Binding IsMonthGridView}"
                        Padding="10,3.5" FontSize="11.5"
                        Content="{Binding Loc.CalViewMonthGrid}"/>
                <Button Name="BtnViewList"
                        Classes="seg-pill"
                        Classes.active="{Binding IsListView}"
                        Padding="10,3.5" FontSize="11.5"
                        Content="{Binding Loc.CalViewList}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnPrevMonth" Classes="secondary-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.CalPrevMonth}"/>
              <Button Name="BtnTodayMonth" Classes="secondary-pill" Padding="12,4" FontSize="12" Content="{Binding Loc.CalThisMonth}"/>
              <Button Name="BtnNextMonth" Classes="secondary-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.CalNextMonth}"/>
            </StackPanel>
          </Grid>

          <!-- Row 1: Subheader (Legend in Month Grid mode, Axis selector in List mode) -->
          <!-- A. Legend in Month Grid mode -->
          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,8"
                IsVisible="{Binding IsMonthGridView}">
            <TextBlock Text="💡 鼠标悬停日期即可通过悬浮窗查看任务详情，单击可查看下方清单"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Border Background="#240284C7" BorderBrush="#660284C7" BorderThickness="1" CornerRadius="3" Padding="4,1">
                  <TextBlock Text="🌱 +N" FontSize="9.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                </Border>
                <TextBlock Text="{Binding Loc.CalCreatedLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Border Background="#2416A34A" BorderBrush="#6616A34A" BorderThickness="1" CornerRadius="3" Padding="4,1">
                  <TextBlock Text="✓ N" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A"/>
                </Border>
                <TextBlock Text="{Binding Loc.CalCompletedLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Border Background="#24D97706" BorderBrush="#66D97706" BorderThickness="1" CornerRadius="3" Padding="4,1">
                  <TextBlock Text="⏰ N" FontSize="9.5" FontWeight="SemiBold" Foreground="#D97706"/>
                </Border>
                <TextBlock Text="{Binding Loc.CalDueLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- B. Calendar Axis Selector (List View Only) -->
          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      Spacing="6"
                      Margin="0,0,0,10"
                      IsVisible="{Binding IsListView}">
            <TextBlock Text="{Binding Loc.CalViewByLabel}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Button Name="BtnAxisDue" Classes="seg-pill" Classes.active="{Binding IsAxisDue}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisDue}"/>
            <Button Name="BtnAxisStart" Classes="seg-pill" Classes.active="{Binding IsAxisStart}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisStart}"/>
            <Button Name="BtnAxisCreated" Classes="seg-pill" Classes.active="{Binding IsAxisCreated}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisCreated}"/>
            <Button Name="BtnAxisClosed" Classes="seg-pill" Classes.active="{Binding IsAxisClosed}" Padding="10,3.5" FontSize="12" Content="{Binding Loc.CalAxisClosed}"/>
          </StackPanel>

          <!-- Row 2: Main Body -->
          <Border Grid.Row="2"
                  Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12"
                  BoxShadow="{DynamicResource CardShadow}">
            <Panel>
              <!-- 1. MONTH CALENDAR GRID VIEW (Default) -->
              <ScrollViewer IsVisible="{Binding IsMonthGridView}">
                <StackPanel Spacing="10">
                  <!-- Weekday Bar (7 Columns: Mon to Sun) -->
                  <Border Background="{DynamicResource BgSubtle}"
                          CornerRadius="6"
                          Padding="4,6">
                    <UniformGrid Columns="7">
                      <TextBlock Text="{Binding Loc.CalMon}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding Loc.CalTue}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding Loc.CalWed}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding Loc.CalThu}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding Loc.CalFri}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding Loc.CalSat}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}"/>
                      <TextBlock Text="{Binding Loc.CalSun}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}"/>
                    </UniformGrid>
                  </Border>

                  <!-- 42 Day Cells Grid (6 weeks x 7 days) -->
                  <ItemsControl ItemsSource="{Binding MonthDays}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalendarDayCellViewModel">
                        <Button Classes="cal-cell-btn"
                                Classes.other-month="{Binding !IsCurrentMonth}"
                                Classes.today="{Binding IsToday}"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding $parent[Window].((vm:CalendarViewModel)DataContext).SelectDay}"
                                CommandParameter="{Binding}"
                                ToolTip.ShowDelay="80">
                          <!-- Floating Window on Hover (悬浮窗显示任务) -->
                          <ToolTip.Tip>
                            <Border Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12,10"
                                    BoxShadow="0 8 24 0 #40000000"
                                    MinWidth="240"
                                    MaxWidth="320">
                              <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding DayHeaderTitle}"
                                             FontWeight="SemiBold"
                                             FontSize="12.5"
                                             Foreground="{DynamicResource TextPrimary}"
                                             VerticalAlignment="Center"/>
                                  <Border Grid.Column="1"
                                          IsVisible="{Binding IsToday}"
                                          Background="{DynamicResource AccentPrimary}"
                                          CornerRadius="4"
                                          Padding="5,1">
                                    <TextBlock Text="{Binding $parent[Window].((vm:CalendarViewModel)DataContext).Loc.TodayLabel}"
                                               Foreground="White"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"/>
                                  </Border>
                                </Grid>

                                <Separator Background="{DynamicResource BorderSubtle}" Height="1"/>

                                <!-- Created Tasks in Floating Window -->
                                <StackPanel IsVisible="{Binding HasCreatedTasks}" Spacing="3">
                                  <TextBlock Text="{Binding CreatedSectionTitle}"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             Foreground="#0284C7"/>
                                  <ItemsControl ItemsSource="{Binding CreatedTasks}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="contracts:RecordView">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                          <TextBlock Grid.Column="0" Text="• " Foreground="#0284C7" FontSize="11.5"/>
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding DisplayTitle}"
                                                     FontSize="11.5"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>

                                <!-- Completed Tasks in Floating Window -->
                                <StackPanel IsVisible="{Binding HasCompletedTasks}" Spacing="3">
                                  <TextBlock Text="{Binding CompletedSectionTitle}"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             Foreground="#16A34A"/>
                                  <ItemsControl ItemsSource="{Binding CompletedTasks}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="contracts:RecordView">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                          <TextBlock Grid.Column="0" Text="✓ " Foreground="#16A34A" FontSize="11.5" FontWeight="Bold"/>
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding DisplayTitle}"
                                                     FontSize="11.5"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>

                                <!-- Due Tasks in Floating Window -->
                                <StackPanel IsVisible="{Binding HasDueTasks}" Spacing="3">
                                  <TextBlock Text="{Binding DueSectionTitle}"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             Foreground="#D97706"/>
                                  <ItemsControl ItemsSource="{Binding DueTasks}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="contracts:RecordView">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                          <TextBlock Grid.Column="0" Text="⏰ " Foreground="#D97706" FontSize="11.5"/>
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding DisplayTitle}"
                                                     FontSize="11.5"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>

                                <!-- Empty State in Floating Window -->
                                <TextBlock IsVisible="{Binding !HasTasks}"
                                           Text="{Binding EmptyHoverText}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}"/>
                              </StackPanel>
                            </Border>
                          </ToolTip.Tip>

                          <!-- Day Cell Content on Calendar Grid (Fixed Area & Proportions) -->
                          <Grid RowDefinitions="Auto,*">
                            <!-- Top Bar: Day Number & Today indicator -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding DayNumber}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimary}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"/>
                              <Border Grid.Column="1"
                                      IsVisible="{Binding IsToday}"
                                      Background="{DynamicResource AccentPrimary}"
                                      CornerRadius="3"
                                      Padding="4,0.5"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding $parent[Window].((vm:CalendarViewModel)DataContext).Loc.TodayLabel}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                              </Border>
                            </Grid>

                            <!-- Bottom Badges: Created, Completed, Due Tasks -->
                            <WrapPanel Grid.Row="1"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"
                                       Orientation="Horizontal"
                                       Margin="0,4,0,0">
                              <!-- Created Tasks Marker -->
                              <Border IsVisible="{Binding HasCreatedTasks}"
                                      Background="#240284C7"
                                      BorderBrush="#660284C7"
                                      BorderThickness="1"
                                      CornerRadius="3"
                                      Padding="3.5,1"
                                      Margin="0,1,3,1">
                                <TextBlock Text="{Binding CreatedCount, StringFormat='🌱+{0}'}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#0284C7"/>
                              </Border>

                              <!-- Completed Tasks Marker -->
                              <Border IsVisible="{Binding HasCompletedTasks}"
                                      Background="#2416A34A"
                                      BorderBrush="#6616A34A"
                                      BorderThickness="1"
                                      CornerRadius="3"
                                      Padding="3.5,1"
                                      Margin="0,1,3,1">
                                <TextBlock Text="{Binding CompletedCount, StringFormat='✓{0}'}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#16A34A"/>
                              </Border>

                              <!-- Due Tasks Marker -->
                              <Border IsVisible="{Binding HasDueTasks}"
                                      Background="#24D97706"
                                      BorderBrush="#66D97706"
                                      BorderThickness="1"
                                      CornerRadius="3"
                                      Padding="3.5,1"
                                      Margin="0,1,3,1">
                                <TextBlock Text="{Binding DueCount, StringFormat='⏰{0}'}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#D97706"/>
                              </Border>
                            </WrapPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Selected Date Task Drawer / List -->
                  <Border Background="{DynamicResource BgSubtle}"
                          BorderBrush="{DynamicResource BorderSubtle}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="12,10"
                          Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding SelectedDayHeader}"
                                 FontWeight="SemiBold"
                                 FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}"/>

                      <ItemsControl ItemsSource="{Binding SelectedDayItems}"
                                    IsVisible="{Binding HasSelectedDayItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="contracts:RecordView">
                            <Border Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,2.5">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource BgHover}"
                                        CornerRadius="4"
                                        Padding="5,1.5"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Status}"
                                             FontSize="10.5"
                                             Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayTitle}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Effective.Assignee, StringFormat='👤 {0}'}"
                                           IsVisible="{Binding Effective.Assignee, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock IsVisible="{Binding !HasSelectedDayItems}"
                                 Text="{Binding Loc.CalNoTasksSelectedDay}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextMuted}"
                                 Margin="2,2"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- 2. LIST VIEW (Previous chronological ledger) -->
              <ScrollViewer IsVisible="{Binding IsListView}">
                <ItemsControl ItemsSource="{Binding MonthEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:CalendarEntry">
                      <Border Background="{DynamicResource BgSubtle}"
                              CornerRadius="7"
                              Padding="12,8"
                              Margin="0,3">
                        <Grid ColumnDefinitions="95,*,Auto,Auto">
                          <Border Grid.Column="0"
                                  Background="{DynamicResource BgCard}"
                                  CornerRadius="5"
                                  Padding="6,2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Day, TargetNullValue='—'}"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"/>
                          </Border>

                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="6,0">
                            <TextBlock Text="{Binding Record.DisplayTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Record.Body}"
                                       IsVisible="{Binding Record.Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <TextBlock Grid.Column="2"
                                     Text="{Binding Record.Effective.Assignee, StringFormat='👤 {0}'}"
                                     IsVisible="{Binding Record.Effective.Assignee, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     Margin="8,0"/>

                          <Border Grid.Column="3"
                                  Background="{DynamicResource BgHover}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Record.Status}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding !HasMonthEntries}"
                          Spacing="10"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <PathIcon Width="32" Height="32"
                          Foreground="{DynamicResource TextMuted}"
                          Data="M 19 4 L 18 4 L 18 2 L 16 2 L 16 4 L 8 4 L 8 2 L 6 2 L 6 4 L 5 4 A 2 2 0 0 0 3 6 L 3 20 A 2 2 0 0 0 5 22 L 19 22 A 2 2 0 0 0 21 20 L 21 6 A 2 2 0 0 0 19 4 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 19 8 L 5 8 L 5 6 L 19 6 L 19 8 Z"/>
                <TextBlock Text="{Binding Loc.CalEmptyTitle}"
                           FontSize="13.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Loc.CalEmptySubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Tab 2: Historical Archive & Trash -->
      <TabItem Header="{Binding Loc.TabArchiveTrash}" FontSize="13.5">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <!-- Filter & Search Bar -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,220" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Name="BtnShowArchived"
                      Classes="seg-pill"
                      Classes.active="{Binding IsArchiveView}"
                      Padding="12,4"
                      FontSize="12"
                      Content="{Binding Loc.HistArchivedBtn}"/>
              <Button Name="BtnShowTrash"
                      Classes="seg-pill"
                      Classes.active="{Binding IsTrashView}"
                      Padding="12,4"
                      FontSize="12"
                      Content="{Binding Loc.HistTrashBtn}"/>
              <Button Name="BtnEmptyTrash"
                      Classes="danger-ghost-btn"
                      IsVisible="{Binding IsTrashView}"
                      IsEnabled="{Binding HasHistoricalItems}"
                      Padding="10,4"
                      FontSize="12"
                      Content="{Binding Loc.BtnEmptyTrash}"
                      ToolTip.Tip="{Binding Loc.BtnEmptyTrashTooltip}"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3">
              <TextBox Name="HistorySearchBox"
                       Classes="clean-input"
                       Text="{Binding HistorySearchText}"
                       PlaceholderText="{Binding Loc.HistSearchPlaceholder}"
                       FontSize="12"/>
            </Border>
          </Grid>

          <!-- Historical Records List -->
          <Border Grid.Row="1"
                  Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12"
                  BoxShadow="{DynamicResource CardShadow}">
            <Panel>
              <ScrollViewer IsVisible="{Binding HasHistoricalItems}">
                <ItemsControl ItemsSource="{Binding HistoricalItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:RecordView">
                      <Border Background="{DynamicResource BgSubtle}"
                              CornerRadius="7"
                              Padding="12,8"
                              Margin="0,3">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Body}"
                                       IsVisible="{Binding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding ClosedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                     IsVisible="{Binding ClosedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Foreground="{DynamicResource TextMuted}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="10,0"/>

                          <Button Grid.Column="2"
                                  Classes="ghost-link"
                                  FontSize="11.5"
                                  Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistReopenBtn}"
                                  Tag="{Binding Id}"
                                  IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNull}}"
                                  Click="OnReopenRecordClick"
                                  ToolTip.Tip="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistReopenTooltip}"/>

                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-link"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource StatusOverdue}"
                                    Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistDeleteBtn}"
                                    Tag="{Binding Id}"
                                    IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNull}}"
                                    Click="OnTrashRecordClick"/>
                            <Button Classes="ghost-link"
                                    FontSize="11.5"
                                    Content="{Binding Source={x:Static loc:AppLocalizer.Instance}, Path=HistRestoreBtn}"
                                    Tag="{Binding Id}"
                                    IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Click="OnRestoreRecordClick"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding !HasHistoricalItems}"
                          Spacing="10"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <PathIcon Width="32" Height="32"
                          Foreground="{DynamicResource TextMuted}"
                          Data="M 6 19 A 2 2 0 0 0 8 21 L 16 21 A 2 2 0 0 0 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"/>
                <TextBlock Text="{Binding Loc.HistEmptyTitle}"
                           FontSize="13.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Loc.HistEmptySubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Tab 3: Settings & Backup -->
      <TabItem Header="{Binding Loc.TabSettings}" FontSize="13.5">
        <ScrollViewer Margin="0,12,0,0">
          <StackPanel Spacing="12">
                        <!-- 0. Visual Style Switching -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetStyleSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetStyleLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetStyleDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnStyleRealistic"
                            Classes="seg-pill"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetStyleRealisticBtn}"/>
                    <Button Name="BtnStyleMinimalist"
                            Classes="seg-pill"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetStyleMinimalistBtn}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

<!-- 1. Language & Time Zone Card -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Loc.SetLangSectionTitle}"
                             FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalAlignment="Center"/>
                  <Border Grid.Column="1"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="5"
                          Padding="8,3"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc.DetectedTimeZoneSummary}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11.5"/>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLangLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLangDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnLangEn"
                            Classes="seg-pill"
                            Classes.active="{Binding Loc.IsEnglish}"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetLangEnBtn}"/>
                    <Button Name="BtnLangZh"
                            Classes="seg-pill"
                            Classes.active="{Binding Loc.IsChinese}"
                            Padding="10,4"
                            FontSize="12"
                            Content="{Binding Loc.SetLangZhBtn}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 2. Window & Desktop Placement -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetWindowSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLayerLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLayerDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnModeTopmost" Classes="seg-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.SetModeTopmostBtn}"/>
                    <Button Name="BtnModeDesktop" Classes="seg-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.SetModeDesktopBtn}"/>
                    <Button Name="BtnModeNormal" Classes="seg-pill" Padding="10,4" FontSize="12" Content="{Binding Loc.SetModeNormalBtn}"/>
                  </StackPanel>
                </Grid>

                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,2"/>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetLockLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetLockDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <CheckBox Name="CheckLockPosition"
                            Grid.Column="1"
                            Classes="task-check"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,2"/>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Loc.SetStartupLabel}"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Loc.SetStartupDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>
                  <CheckBox Name="CheckLaunchAtLogin"
                            Grid.Column="1"
                            Classes="task-check"
                            VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 3. Global Default Attachment Storage Directory -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetAttachmentSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Loc.SetAttachmentDesc}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                  <Border Grid.Column="0"
                          Background="{DynamicResource BgSubtle}"
                          CornerRadius="6"
                          Padding="10,6"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                    <TextBlock Name="GlobalAttachmentPathText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <Button Name="BtnChangeGlobalAttachmentPath"
                          Grid.Column="1"
                          Classes="secondary-pill"
                          Padding="12,5"
                          FontSize="12"
                          Margin="0,0,6,0"
                          Content="{Binding Loc.SetChangeFolderBtn}"/>
                  <Button Name="BtnOpenGlobalAttachmentPath"
                          Grid.Column="2"
                          Classes="secondary-pill"
                          Padding="12,5"
                          FontSize="12"
                          Content="{Binding Loc.SetOpenFolderBtn}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 4. Action History & Undo (支持误操作撤销与恢复) -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetUndoSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Loc.SetUndoDesc}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Name="UndoStatusTextBlock"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="快捷提示：主面板按 Ctrl+Z 亦可随时撤销上一步误操作"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"/>
                  </StackPanel>

                  <Button Name="BtnUndoLastAction"
                          Grid.Column="1"
                          Classes="secondary-pill"
                          Content="{Binding Loc.SetUndoBtn}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 5. Backup & Restore -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Loc.SetBackupSectionTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Loc.SetBackupDesc}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button Name="BtnExportBackup"
                          Classes="secondary-pill"
                          Content="{Binding Loc.SetExportBackupBtn}"/>
                  <Button Name="BtnRestoreBackup"
                          Classes="secondary-pill"
                          Content="{Binding Loc.SetRestoreBackupBtn}"/>
                  <TextBlock Name="SettingsStatusText"
                             Foreground="{DynamicResource AccentPrimary}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
    </Border>

    <!-- Secondary Confirmation Dialog Overlay for Emptying Trash -->
    <Border Name="EmptyTrashConfirmOverlay"
            IsVisible="False"
            Background="#70000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1.5"
              CornerRadius="12"
              Padding="24,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="420"
              BoxShadow="0 8 32 #40000000">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="20" Background="#26EA3323">
              <TextBlock Text="🗑️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Loc.ConfirmEmptyTrashTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{Binding Loc.ConfirmEmptyTrashSubtitle}" FontSize="12" Foreground="{DynamicResource StatusOverdue}" FontWeight="Medium"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Loc.ConfirmEmptyTrashMessage}"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource TextSecondary}"
                     LineHeight="20"/>

          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
            <Button Name="BtnCancelEmptyTrash"
                    Grid.Column="1"
                    Classes="seg-pill"
                    Padding="16,6"
                    Margin="0,0,10,0"
                    FontSize="12.5"
                    Content="{Binding Loc.CancelBtn}"/>
            <Button Name="BtnConfirmEmptyTrash"
                    Grid.Column="2"
                    Classes="danger-btn"
                    Padding="16,6"
                    FontSize="12.5"
                    Content="{Binding Loc.ConfirmEmptyTrashBtn}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
