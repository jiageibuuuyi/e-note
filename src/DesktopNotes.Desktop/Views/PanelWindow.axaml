<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:controls="using:DesktopNotes.Desktop.Controls"
        x:Class="DesktopNotes.Desktop.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="350" Height="520" MinWidth="280" MinHeight="360"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="桌面笔记">
  <Border BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="10,8,10,6">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- 1. Ultra-Compact Top Bar: Mode Pill (Left) + Drag Region (Center) + Ghost Icons (Right) -->
      <Grid Name="HeaderDragRegion"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            Height="28"
            Margin="0,0,0,6">

        <!-- Mode Indicator / Toggle (Left) -->
        <Button Name="BtnKindSelector"
                Grid.Column="0"
                Classes="mode-pill"
                ToolTip.Tip="点击快速切换 待办 / 笔记">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="{Binding KindIconData}"/>
            <TextBlock Text="{Binding CurrentKindText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
            <Border Background="{DynamicResource BgHover}"
                    CornerRadius="3"
                    Padding="4,0.5"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalCount}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="10.5"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Button>

        <!-- Right Action Icons: Search + Three-dot Menu + Close -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- Search Toggle -->
          <Button Name="BtnSearchToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="精确搜索 (Ctrl+F)">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 14z"/>
          </Button>

          <!-- Three Dots Menu for Transactions & Settings -->
          <Button Name="BtnMoreOptions"
                  Classes="icon-ghost"
                  ToolTip.Tip="更多选项与事务切换">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M6 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm6 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm6 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Name="BtnTabTasks" Header="📋  待办事项">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnTabNotes" Header="📝  随手笔记">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Name="BtnQuickAdd" Header="➕  详情新建...">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnCalendar" Header="📅  月历与管理">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnThemeToggle" Header="🌓  切换外观主题">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Close Window -->
          <Button Name="BtnCloseWindow"
                  Classes="icon-ghost"
                  ToolTip.Tip="关闭窗口">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 2. Slim Collapsible Search Box -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsSearchOpen}"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,3"
              Margin="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Width="11" Height="11"
                    Foreground="{DynamicResource TextMuted}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          <TextBox Name="SearchBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding SearchText}"
                   FontSize="12"
                   PlaceholderText="输入关键词搜索... (Esc 清空)"/>
          <Button Name="BtnClearSearch"
                  Grid.Column="2"
                  Classes="icon-ghost"
                  Width="18" Height="18"
                  Content="✕"
                  FontSize="10"
                  ToolTip.Tip="清空搜索"/>
        </Grid>
      </Border>

      <!-- 3. Slim Quick Capture Row (Enter to create) -->
      <Border Grid.Row="2"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,3"
              Margin="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Width="10" Height="10"
                    Foreground="{DynamicResource AccentPrimary}"
                    Margin="2,0,7,0"
                    VerticalAlignment="Center"
                    Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
          <TextBox Name="QuickInputBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding QuickInputText}"
                   FontSize="12"
                   PlaceholderText="{Binding QuickInputPlaceholder}"/>
          <TextBlock Grid.Column="2"
                     Text="↵"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="4,0,2,0"/>
          <Button Name="BtnSubmitQuick"
                  Grid.Column="2"
                  IsVisible="False"/>
        </Grid>
      </Border>

      <!-- 4. Virtualized Task/Note List & Calm Empty State -->
      <Panel Grid.Row="3">
        <ListBox Name="RecordListBox"
                 ItemsSource="{Binding Items}"
                 IsVisible="{Binding !IsEmpty}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <controls:TaskRow/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Calm Empty State View -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    Margin="16">
          <Border Width="38" Height="38"
                  CornerRadius="19"
                  Background="{DynamicResource BgSubtle}"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,4">
            <PathIcon Width="16" Height="16"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </Border>
          <TextBlock Text="{Binding EmptyStateTitle}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="13"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyStateSubtitle}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11.5"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="220"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>

      <!-- 5. Low-Noise Whisper Counter (No explanatory clutter) -->
      <Border Grid.Row="4"
              IsVisible="{Binding HasFooterContent}"
              Margin="2,3,2,0">
        <TextBlock Text="{Binding WhisperStatus}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   HorizontalAlignment="Center"/>
      </Border>

    </Grid>
  </Border>
</Window>
