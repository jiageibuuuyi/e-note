<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:controls="using:DesktopNotes.Desktop.Controls"
        x:Class="DesktopNotes.Desktop.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="360" Height="560" MinWidth="300" MinHeight="400"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="桌面笔记">
  <Border BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="14,14,14,10">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- 1. Unified Top Navigation: Segmented Control + Icon Actions -->
      <Grid Name="HeaderDragRegion"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            Margin="0,0,0,12">

        <!-- Segmented Tab: 待办 / 笔记 -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSubtle}"
                CornerRadius="8"
                Padding="2.5">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="BtnTabTasks"
                    Classes="seg-pill"
                    Classes.active="{Binding IsTaskTab}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="待办" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BgHover}"
                        CornerRadius="4"
                        Padding="5,1"
                        IsVisible="{Binding IsTaskTab}">
                  <TextBlock Text="{Binding TotalCount}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
            </Button>

            <Button Name="BtnTabNotes"
                    Classes="seg-pill"
                    Classes.active="{Binding IsNoteTab}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="笔记" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BgHover}"
                        CornerRadius="4"
                        Padding="5,1"
                        IsVisible="{Binding IsNoteTab}">
                  <TextBlock Text="{Binding TotalCount}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Right Quick Action Icons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
          <!-- Search Toggle -->
          <Button Name="BtnSearchToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="精确搜索 (Ctrl+F)">
            <PathIcon Width="14" Height="14"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </Button>

          <!-- Calendar & Manager -->
          <Button Name="BtnCalendar"
                  Classes="icon-ghost"
                  ToolTip.Tip="月历与设置">
            <PathIcon Width="14" Height="14"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>
          </Button>

          <!-- Light / Dark Theme Toggle -->
          <Button Name="BtnThemeToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="切换浅色/深色主题">
            <PathIcon Width="14" Height="14"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </Button>

          <!-- Close Window -->
          <Button Name="BtnCloseWindow"
                  Classes="icon-ghost"
                  ToolTip.Tip="关闭窗口">
            <PathIcon Width="12" Height="12"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 2. Collapsible Search Box -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsSearchOpen}"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1"
              CornerRadius="9"
              Padding="10,6"
              Margin="0,0,0,10"
              BoxShadow="{DynamicResource CardShadow}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Width="13" Height="13"
                    Foreground="{DynamicResource TextMuted}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          <TextBox Name="SearchBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding SearchText}"
                   FontSize="12.5"
                   PlaceholderText="输入关键字精确搜索... (Esc 清空)"/>
          <Button Name="BtnClearSearch"
                  Grid.Column="2"
                  Classes="icon-ghost"
                  Width="20" Height="20"
                  Content="✕"
                  FontSize="11"
                  ToolTip.Tip="清空搜索"/>
        </Grid>
      </Border>

      <!-- 3. Floating Quick Capture Card (Enter to create) -->
      <Border Grid.Row="2"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,8"
              Margin="0,0,0,10"
              BoxShadow="{DynamicResource CardShadow}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- + Icon -->
          <TextBlock Grid.Column="0"
                     Text="+"
                     Foreground="{DynamicResource AccentPrimary}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="0,0,8,1"/>

          <!-- Text Input -->
          <TextBox Name="QuickInputBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding QuickInputText}"
                   FontSize="13"
                   PlaceholderText="{Binding QuickInputPlaceholder}"/>

          <!-- Keyboard Shortcut Hint Badge -->
          <Border Grid.Column="2"
                  Background="{DynamicResource BgSubtle}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,2"
                  VerticalAlignment="Center">
            <TextBlock Text="↵ Enter"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       FontFamily="Consolas, monospace"/>
          </Border>

          <!-- Hidden Submit Button for test compatibility -->
          <Button Name="BtnSubmitQuick"
                  Grid.Column="2"
                  IsVisible="False"/>
        </Grid>
      </Border>

      <!-- 4. Virtualized Task/Note List & Calm Empty State -->
      <Panel Grid.Row="3">
        <ListBox Name="RecordListBox"
                 ItemsSource="{Binding Items}"
                 IsVisible="{Binding !IsEmpty}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <controls:TaskRow/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty State View -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="24">
          <Border Width="44" Height="44"
                  CornerRadius="22"
                  Background="{DynamicResource BgSubtle}"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,4">
            <PathIcon Width="18" Height="18"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </Border>
          <TextBlock Text="{Binding EmptyStateTitle}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="14"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyStateSubtitle}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="12"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="240"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>

      <!-- 5. Status & Footer Strip -->
      <Grid Grid.Row="4"
            ColumnDefinitions="*,Auto"
            Margin="2,8,2,2">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11.5"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Button Name="BtnQuickAdd"
                Grid.Column="1"
                Classes="ghost-link"
                Content="详情新建 ↗"
                ToolTip.Tip="打开详情窗口创建带有完整属性的记录"/>
      </Grid>

    </Grid>
  </Border>
</Window>
