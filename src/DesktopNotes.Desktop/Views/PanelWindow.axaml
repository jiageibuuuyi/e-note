<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:controls="using:DesktopNotes.Desktop.Controls"
        x:Class="DesktopNotes.Desktop.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="350" Height="520" MinWidth="280" MinHeight="360"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="桌面笔记">
  <Border BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="10,8,10,6">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 1. Ultra-Compact Top Bar: Mode Pill (Left) + Drag Region (Center) + Ghost Icons (Right) -->
      <Grid Name="HeaderDragRegion"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            Height="28"
            Margin="0,0,0,6">

        <!-- Mode Indicator / Toggle (Left) -->
        <Button Name="BtnKindSelector"
                Grid.Column="0"
                Classes="mode-pill"
                ToolTip.Tip="点击快速切换 待办 / 笔记">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="{Binding KindIconData}"/>
            <TextBlock Text="{Binding CurrentKindText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
            <Border Background="{DynamicResource BgHover}"
                    CornerRadius="3"
                    Padding="4,0.5"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalCount}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="10.5"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Button>

        <!-- Right Action Icons: + Add Inline + Search + Three-dot Menu + Hide to Tray -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- + Add New Blank Row at Bottom of List -->
          <Button Name="BtnAddInline"
                  Classes="icon-ghost"
                  ToolTip.Tip="在列表末尾新增空白输入行 (Ctrl+N)">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
          </Button>

          <!-- Search Toggle -->
          <Button Name="BtnSearchToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="精确搜索 (Ctrl+F)">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M 15.5 14 L 14.71 14 L 14.43 13.73 A 6.5 6.5 0 1 0 13.73 14.43 L 14 14.71 L 14 15.5 L 19 20.49 L 20.49 19 L 15.5 14 Z M 9.5 14 A 4.5 4.5 0 1 1 14 9.5 A 4.5 4.5 0 0 1 9.5 14 Z"/>
          </Button>

          <!-- Three Dots Menu for Transactions, Sorting, Placement & Settings -->
          <Button Name="BtnMoreOptions"
                  Classes="icon-ghost"
                  ToolTip.Tip="事务切换 · 排序方式 · 桌面层级 · 日历与归档">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M 6 12 A 2 2 0 1 1 2 12 A 2 2 0 1 1 6 12 Z M 14 12 A 2 2 0 1 1 10 12 A 2 2 0 1 1 14 12 Z M 22 12 A 2 2 0 1 1 18 12 A 2 2 0 1 1 22 12 Z"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Name="BtnTabTasks" Header="📋  待办事项">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 L 9 16.17 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnTabNotes" Header="📝  随手笔记">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 3 17.25 L 3 21 L 6.75 21 L 17.81 9.94 L 14.06 6.19 L 3 17.25 Z M 20.71 7.04 L 18.37 4.7 L 16.54 6.53 L 20.29 10.28 L 20.71 7.04 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="↕️  排列方式">
                  <MenuItem Name="MenuSortDefault" Header="默认综合排序 (优先级 → 截止期 → 创建时间)"/>
                  <MenuItem Name="MenuSortDeadline" Header="按截止时间排序 (最近到期优先)"/>
                  <MenuItem Name="MenuSortPriority" Header="按优先级重要程度排序"/>
                  <MenuItem Name="MenuSortCreated" Header="按创建时间排序 (最新创建优先)"/>
                </MenuItem>
                <MenuItem Header="📌  窗口桌面层级与锁定">
                  <MenuItem Name="MenuPlaceTopmost" Header="📌 悬浮在所有应用最上层 (置顶)"/>
                  <MenuItem Name="MenuPlaceBottom" Header="🖥️ 置于所有应用最下层 (桌面底层)"/>
                  <Separator/>
                  <MenuItem Name="MenuToggleLock" Header="🔒 锁定 / 解锁当前桌面位置"/>
                </MenuItem>
                <Separator/>
                <MenuItem Name="BtnQuickAdd" Header="➕  详情窗口新建...">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnCalendar" Header="📅  任务日历 · 历史归档 · 设置">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 19 4 L 18 4 L 18 2 L 16 2 L 16 4 L 8 4 L 8 2 L 6 2 L 6 4 L 5 4 A 2 2 0 0 0 3 6 L 3 20 A 2 2 0 0 0 5 22 L 19 22 A 2 2 0 0 0 21 20 L 21 6 A 2 2 0 0 0 19 4 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 19 8 L 5 8 L 5 6 L 19 6 L 19 8 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnThemeToggle" Header="🌓  切换外观主题">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 12 3 A 9 9 0 1 0 21 12 A 5.4 5.4 0 0 1 12 3 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Name="MenuHideToTray" Header="🔽  隐藏到右下角系统托盘"/>
                <MenuItem Name="MenuExitApp" Header="🚪  彻底退出桌面笔记"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Minimize / Hide to Tray Button -->
          <Button Name="BtnCloseWindow"
                  Classes="icon-ghost"
                  ToolTip.Tip="隐藏到系统右下角托盘 (彻底退出请通过 ⋯ 菜单或托盘右键)">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 L 19 6.41 Z"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 2. Slim Collapsible Search Box -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsSearchOpen}"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,3"
              Margin="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Width="11" Height="11"
                    Foreground="{DynamicResource TextMuted}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Data="M 15.5 14 L 14.71 14 L 14.43 13.73 A 6.5 6.5 0 1 0 13.73 14.43 L 14 14.71 L 14 15.5 L 19 20.49 L 20.49 19 L 15.5 14 Z M 9.5 14 A 4.5 4.5 0 1 1 14 9.5 A 4.5 4.5 0 0 1 9.5 14 Z"/>
          <TextBox Name="SearchBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding SearchText}"
                   FontSize="12"
                   PlaceholderText="输入关键词搜索... (Esc 清空)"/>
          <Button Name="BtnClearSearch"
                  Grid.Column="2"
                  Classes="icon-ghost"
                  Width="18" Height="18"
                  Content="✕"
                  FontSize="10"
                  ToolTip.Tip="清空搜索"/>
        </Grid>
      </Border>

      <!-- 3. Virtualized Task/Note List & Calm Empty State -->
      <Panel Grid.Row="2">
        <ListBox Name="RecordListBox"
                 ItemsSource="{Binding Items}"
                 IsVisible="{Binding !IsEmpty}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <controls:TaskRow/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Calm Empty State View with + Action -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="16">
          <Button Name="BtnEmptyAdd"
                  Width="40" Height="40"
                  CornerRadius="20"
                  Background="{DynamicResource BgSubtle}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  HorizontalAlignment="Center"
                  Cursor="Hand"
                  ToolTip.Tip="点击新增一项">
            <PathIcon Width="14" Height="14"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
          </Button>
          <TextBlock Text="{Binding EmptyStateTitle}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="13"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyStateSubtitle}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11.5"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="220"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>

      <!-- 4. Bottom Strip: Subtle + Add Row Button & Low-Noise Counter -->
      <Grid Grid.Row="3"
            ColumnDefinitions="Auto,*,Auto"
            Margin="2,4,2,0">
        <Button Name="BtnBottomAdd"
                Grid.Column="0"
                Classes="ghost-link"
                Padding="6,2"
                FontSize="11.5"
                Content="+ 新增"
                ToolTip.Tip="在列表末尾增加空白输入行"/>
        <TextBlock Grid.Column="2"
                   IsVisible="{Binding HasFooterContent}"
                   Text="{Binding WhisperStatus}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   VerticalAlignment="Center"/>
      </Grid>

    </Grid>
  </Border>
</Window>
