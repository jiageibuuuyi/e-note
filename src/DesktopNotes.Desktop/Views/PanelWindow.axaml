<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNotes.Desktop.ViewModels"
        xmlns:controls="using:DesktopNotes.Desktop.Controls"
        x:Class="DesktopNotes.Desktop.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="350" Height="520" MinWidth="280" MinHeight="360"
        Background="{DynamicResource BgWindow}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="{Binding Loc.AppTitle}">
  <Border BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          Padding="10,8,10,6">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 1. Ultra-Compact Top Bar: Mode Pill (Left) + Drag Region (Center) + Ghost Icons (Right) -->
      <Grid Name="HeaderDragRegion"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            Height="28"
            Margin="0,0,0,6"
            ToolTip.Tip="{Binding Loc.HeaderDragTooltip}">
        <Grid.ContextMenu>
          <ContextMenu Name="HeaderContextMenu">
            <MenuItem Name="CtxToggleLock" Header="🔒  Lock Window Position"/>
            <Separator/>
            <MenuItem Name="CtxPlaceTopmost" Header="📌  Always on Top"/>
            <MenuItem Name="CtxPlaceBottom" Header="🖥️  Send to Desktop Back"/>
            <Separator/>
            <MenuItem Header="{Binding Loc.MenuSortHeader}">
              <MenuItem Name="CtxSortDefault" Header="{Binding Loc.MenuSortDefault}"/>
              <MenuItem Name="CtxSortDeadline" Header="{Binding Loc.MenuSortDeadline}"/>
              <MenuItem Name="CtxSortPriority" Header="{Binding Loc.MenuSortPriority}"/>
              <MenuItem Name="CtxSortCreated" Header="{Binding Loc.MenuSortCreated}"/>
            </MenuItem>
            <MenuItem Header="{Binding Loc.MenuLanguageHeader}">
              <MenuItem Name="CtxLangEn" Header="English (Default)"/>
              <MenuItem Name="CtxLangZh" Header="中文 (Chinese)"/>
            </MenuItem>
            <MenuItem Name="CtxSwitchTasks" Header="{Binding Loc.MenuSwitchTasks}"/>
            <MenuItem Name="CtxSwitchNotes" Header="{Binding Loc.MenuSwitchNotes}"/>
            <MenuItem Name="CtxThemeToggle" Header="{Binding Loc.MenuSwitchTheme}"/>
            <Separator/>
            <MenuItem Name="CtxOpenSettings" Header="{Binding Loc.MenuOpenSettings}"/>
            <MenuItem Name="CtxOpenCalendar" Header="{Binding Loc.MenuCalendarArchive}"/>
            <MenuItem Name="CtxArchiveAllCompleted" Header="{Binding Loc.MenuArchiveAllDone}"/>
            <Separator/>
            <MenuItem Name="CtxHideToTray" Header="{Binding Loc.MenuHideToTray}"/>
            <MenuItem Name="CtxExitApp" Header="{Binding Loc.MenuExitApp}"/>
          </ContextMenu>
        </Grid.ContextMenu>

        <!-- Mode Indicator / Toggle (Left) -->
        <Button Name="BtnKindSelector"
                Grid.Column="0"
                Classes="mode-pill"
                ToolTip.Tip="{Binding Loc.KindSwitchTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="{Binding KindIconData}"/>
            <TextBlock Text="{Binding CurrentKindText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
            <Border Background="{DynamicResource BgHover}"
                    CornerRadius="3"
                    Padding="4,0.5"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalCount}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="10.5"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Button>

        <!-- Right Action Icons: + Add Inline + Search + Lock + Three-dot Menu + Hide to Tray -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- + Add New Blank Row at Bottom of List -->
          <Button Name="BtnAddInline"
                  Classes="icon-ghost"
                  ToolTip.Tip="{Binding Loc.AddInlineTooltip}">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
          </Button>

          <!-- Search Toggle -->
          <Button Name="BtnSearchToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="{Binding Loc.SearchTooltip}">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M 15.5 14 L 14.71 14 L 14.43 13.73 A 6.5 6.5 0 1 0 13.73 14.43 L 14 14.71 L 14 15.5 L 19 20.49 L 20.49 19 L 15.5 14 Z M 9.5 14 A 4.5 4.5 0 1 1 14 9.5 A 4.5 4.5 0 0 1 9.5 14 Z"/>
          </Button>

          <!-- Lock / Unlock Position Toggle -->
          <Button Name="BtnLockToggle"
                  Classes="icon-ghost"
                  ToolTip.Tip="Lock / Unlock window position">
            <PathIcon Name="IconLockState"
                      Width="12" Height="12"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M 18 8 L 17 8 L 17 6 A 5 5 0 0 0 7 6 L 9 6 A 3 3 0 0 1 15 6 L 15 8 L 6 8 A 2 2 0 0 0 4 10 L 4 20 A 2 2 0 0 0 6 22 L 18 22 A 2 2 0 0 0 20 20 L 20 10 A 2 2 0 0 0 18 8 Z"/>
          </Button>

          <!-- Three Dots Menu for Transactions, Sorting, Placement, Language & Settings -->
          <Button Name="BtnMoreOptions"
                  Classes="icon-ghost"
                  ToolTip.Tip="{Binding Loc.MoreOptionsTooltip}">
            <PathIcon Width="13" Height="13"
                      Foreground="{DynamicResource TextSecondary}"
                      Data="M 6 12 A 2 2 0 1 1 2 12 A 2 2 0 1 1 6 12 Z M 14 12 A 2 2 0 1 1 10 12 A 2 2 0 1 1 14 12 Z M 22 12 A 2 2 0 1 1 18 12 A 2 2 0 1 1 22 12 Z"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Name="BtnTabTasks" Header="{Binding Loc.MenuSwitchTasks}">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 L 9 16.17 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnTabNotes" Header="{Binding Loc.MenuSwitchNotes}">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 3 17.25 L 3 21 L 6.75 21 L 17.81 9.94 L 14.06 6.19 L 3 17.25 Z M 20.71 7.04 L 18.37 4.7 L 16.54 6.53 L 20.29 10.28 L 20.71 7.04 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding Loc.MenuSortHeader}">
                  <MenuItem Name="MenuSortDefault" Header="{Binding Loc.MenuSortDefault}"/>
                  <MenuItem Name="MenuSortDeadline" Header="{Binding Loc.MenuSortDeadline}"/>
                  <MenuItem Name="MenuSortPriority" Header="{Binding Loc.MenuSortPriority}"/>
                  <MenuItem Name="MenuSortCreated" Header="{Binding Loc.MenuSortCreated}"/>
                </MenuItem>
                <MenuItem Header="{Binding Loc.MenuLayerHeader}">
                  <MenuItem Name="MenuPlaceTopmost" Header="📌 Always on Top"/>
                  <MenuItem Name="MenuPlaceBottom" Header="🖥️ Send to Desktop Back"/>
                  <Separator/>
                  <MenuItem Name="MenuToggleLock" Header="🔒 Lock / Unlock Position"/>
                </MenuItem>
                <MenuItem Header="{Binding Loc.MenuLanguageHeader}">
                  <MenuItem Name="MenuLangEn" Header="English (Default)"/>
                  <MenuItem Name="MenuLangZh" Header="中文 (Chinese)"/>
                </MenuItem>
                <Separator/>
                <MenuItem Name="BtnQuickAdd" Header="{Binding Loc.MenuQuickAddDetail}">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnCalendar" Header="{Binding Loc.MenuCalendarArchive}">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 19 4 L 18 4 L 18 2 L 16 2 L 16 4 L 8 4 L 8 2 L 6 2 L 6 4 L 5 4 A 2 2 0 0 0 3 6 L 3 20 A 2 2 0 0 0 5 22 L 19 22 A 2 2 0 0 0 21 20 L 21 6 A 2 2 0 0 0 19 4 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 19 8 L 5 8 L 5 6 L 19 6 L 19 8 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="BtnOpenSettings" Header="{Binding Loc.MenuOpenSettings}"/>
                <MenuItem Name="MenuArchiveAllCompleted" Header="{Binding Loc.MenuArchiveAllDone}"/>
                <MenuItem Name="BtnThemeToggle" Header="{Binding Loc.MenuSwitchTheme}">
                  <MenuItem.Icon>
                    <PathIcon Width="11" Height="11" Data="M 12 3 A 9 9 0 1 0 21 12 A 5.4 5.4 0 0 1 12 3 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Name="MenuHideToTray" Header="{Binding Loc.MenuHideToTray}"/>
                <MenuItem Name="MenuExitApp" Header="{Binding Loc.MenuExitApp}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Minimize / Hide to Tray Button -->
          <Button Name="BtnCloseWindow"
                  Classes="icon-ghost"
                  ToolTip.Tip="{Binding Loc.HideToTrayTooltip}">
            <PathIcon Width="11" Height="11"
                      Foreground="{DynamicResource TextMuted}"
                      Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 L 19 6.41 Z"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 2. Slim Collapsible Search Box -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsSearchOpen}"
              Background="{DynamicResource BgCard}"
              BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,3"
              Margin="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Width="11" Height="11"
                    Foreground="{DynamicResource TextMuted}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Data="M 15.5 14 L 14.71 14 L 14.43 13.73 A 6.5 6.5 0 1 0 13.73 14.43 L 14 14.71 L 14 15.5 L 19 20.49 L 20.49 19 L 15.5 14 Z M 9.5 14 A 4.5 4.5 0 1 1 14 9.5 A 4.5 4.5 0 0 1 9.5 14 Z"/>
          <TextBox Name="SearchBox"
                   Grid.Column="1"
                   Classes="clean-input"
                   Text="{Binding SearchText}"
                   FontSize="12"
                   PlaceholderText="{Binding Loc.SearchPlaceholder}"/>
          <Button Name="BtnClearSearch"
                  Grid.Column="2"
                  Classes="icon-ghost"
                  Width="18" Height="18"
                  Content="✕"
                  FontSize="10"
                  ToolTip.Tip="{Binding Loc.ClearSearchTooltip}"/>
        </Grid>
      </Border>

      <!-- 3. Virtualized Task/Note List & Calm Empty State -->
      <Panel Grid.Row="2">
        <ListBox Name="RecordListBox"
                 ItemsSource="{Binding Items}"
                 IsVisible="{Binding !IsEmpty}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <controls:TaskRow/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Calm Empty State View with + Action -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="16">
          <Button Name="BtnEmptyAdd"
                  Width="40" Height="40"
                  CornerRadius="20"
                  Background="{DynamicResource BgSubtle}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  HorizontalAlignment="Center"
                  Cursor="Hand"
                  ToolTip.Tip="{Binding Loc.EmptyAddTooltip}">
            <PathIcon Width="14" Height="14"
                      Foreground="{DynamicResource AccentPrimary}"
                      Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"/>
          </Button>
          <TextBlock Text="{Binding EmptyStateTitle}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="13"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyStateSubtitle}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11.5"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="220"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>

      <!-- 4. Bottom Strip: Subtle + Add Row Button, Confirm Archive Completed & Low-Noise Counter -->
      <Grid Grid.Row="3"
            ColumnDefinitions="Auto,Auto,*,Auto"
            Margin="2,4,2,0">
        <Button Name="BtnBottomAdd"
                Grid.Column="0"
                Classes="ghost-link"
                Padding="6,2"
                FontSize="11.5"
                Content="{Binding Loc.BottomAddText}"
                ToolTip.Tip="{Binding Loc.BottomAddTooltip}"/>
        <Button Name="BtnArchiveCompleted"
                Grid.Column="1"
                IsVisible="{Binding HasCompletedPendingArchive}"
                Classes="ghost-link"
                Padding="8,2"
                Margin="4,0,0,0"
                FontSize="11.5"
                Foreground="{DynamicResource StatusCompleted}"
                Content="{Binding ArchiveCompletedButtonText}"
                ToolTip.Tip="{Binding Loc.ArchiveCompletedTooltip}"/>
        <TextBlock Grid.Column="3"
                   IsVisible="{Binding HasFooterContent}"
                   Text="{Binding WhisperStatus}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   VerticalAlignment="Center"/>
      </Grid>

    </Grid>
  </Border>
</Window>
